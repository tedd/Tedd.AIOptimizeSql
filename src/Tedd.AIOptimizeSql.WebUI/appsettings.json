{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "AIOptimizeDb": ""
  },
  "LaunchBrowser": true,
  "UiPolling": {
    "EntityListRefreshSeconds": 30,
    "ResearchFlowRefreshSeconds": 2
  },
  "OptimizeEngine": {
    "RunInProcess": true,
    "QueuePollIntervalSeconds": 10,
    "BatchStateCheckIntervalSeconds": 5,
    "MaxToolResponseBytes": 524288,
    "AnalysisPollIntervalSeconds": 10,
    "MaxAgentContinuations": 20,
    "WebSearch": {
      "Provider": "Brave",
      "ApiKey": "",
      "MaxResults": 10
    }
  }
}
