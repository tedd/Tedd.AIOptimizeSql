@inject IJSRuntime JS

@{
    var (textPart, sqlPart) = ParseMessage(Log.Message);
}

<MudPaper Elevation="0" Class="pa-2 rounded hypothesis-log-entry" Style="background: var(--mud-palette-background-grey);">
    <MudText Typo="Typo.caption" Class="mud-text-secondary">
        @Log.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
        @if (!string.IsNullOrEmpty(Log.Source))
        {
            <text> · @Log.Source</text>
        }
    </MudText>
    <MudText Typo="Typo.body2" Style="white-space: pre-wrap; word-break: break-word;">@textPart</MudText>

    @if (!string.IsNullOrWhiteSpace(sqlPart))
    {
        <div class="log-sql-block mt-1">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="log-sql-header"
                      @onclick="ToggleSql" Style="cursor: pointer; user-select: none;">
                <MudIcon Icon="@(_sqlExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ChevronRight)"
                         Size="Size.Small" Color="Color.Info" />
                <MudText Typo="Typo.caption" Color="Color.Info" Class="ml-1">SQL</MudText>
                <MudSpacer />
                <span @onclick="CopySqlAsync" @onclick:stopPropagation="true" title="Copy SQL to clipboard">
                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" />
                </span>
            </MudStack>
            <MudCollapse Expanded="_sqlExpanded">
                <pre class="log-sql-content">@sqlPart</pre>
            </MudCollapse>
        </div>
    }
</MudPaper>

@code {
    [Parameter, EditorRequired] public HypothesisLog Log { get; set; } = default!;

    private bool _sqlExpanded;

    private void ToggleSql() => _sqlExpanded = !_sqlExpanded;

    private async Task CopySqlAsync()
    {
        var (_, sql) = ParseMessage(Log.Message);
        if (!string.IsNullOrWhiteSpace(sql))
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", sql);
    }

    internal static (string Text, string? Sql) ParseMessage(string message)
    {
        const string open = "[sql]";
        const string close = "[/sql]";
        var start = message.IndexOf(open, StringComparison.Ordinal);
        if (start < 0)
            return (message, null);

        var sqlStart = start + open.Length;
        var end = message.IndexOf(close, sqlStart, StringComparison.Ordinal);
        var sqlContent = end < 0
            ? message[sqlStart..].Trim()
            : message[sqlStart..end].Trim();

        var textPart = message[..start].TrimEnd('\n', '\r', ' ');
        return (textPart, sqlContent);
    }
}
