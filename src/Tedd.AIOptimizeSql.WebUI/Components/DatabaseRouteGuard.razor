@implements IDisposable
@inject IDatabaseReadinessService Readiness
@inject IDbContextFactory<Tedd.AIOptimizeSql.Database.AIOptimizeDbContext> DbContextFactory
@inject DatabaseScopeNotifier ScopeNotifier
@inject NavigationManager Navigation
@using System.Threading
@using Microsoft.EntityFrameworkCore

@if (_phase == GuardPhase.Checking || _phase == GuardPhase.Redirecting)
{
    <MudStack Justify="Justify.Center" AlignItems="AlignItems.Center" Style="min-height: 70vh;">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
        <MudText Typo="Typo.body1" Class="mt-4">Checking database…</MudText>
    </MudStack>
}
else
{
    <CascadingValue Value="_scope" IsFixed="false">
        <RouteView RouteData="RouteData" DefaultLayout="typeof(MainLayout)" />
        <FocusOnNavigate RouteData="RouteData" Selector="h1" />
    </CascadingValue>
}

@code {
    [Parameter, EditorRequired]
    public RouteData RouteData { get; set; } = default!;

    private GuardPhase _phase = GuardPhase.Checking;

    /// <summary>
    /// The database the current URL is inside, resolved once here and cascaded, so every page,
    /// the nav menu and the app bar all agree on which database they are showing.
    /// </summary>
    private DatabaseScope? _scope;

    // Serialize checks: OnParametersSetAsync and LocationChanged can both run RunGuardAsync; parallel
    // GetStatusAsync calls used to share one scoped DbContext and caused intermittent failures.
    private readonly SemaphoreSlim _guardRunLock = new(1, 1);
    private readonly CancellationTokenSource _cts = new();

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        ScopeNotifier.ScopeChanged += OnScopeChangedAsync;
    }

    private Task OnScopeChangedAsync() => InvokeAsync(async () =>
    {
        _scope = null;
        await RunGuardAsync();
        StateHasChanged();
    });

    protected override async Task OnParametersSetAsync()
    {
        await RunGuardAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = InvokeAsync(async () =>
        {
            await RunGuardAsync();
            StateHasChanged();
        });
    }

    private async Task RunGuardAsync()
    {
        var ct = _cts.Token;
        try
        {
            await _guardRunLock.WaitAsync(ct);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        try
        {
            if (ct.IsCancellationRequested)
                return;

            // Do not flip to Checking on every navigation when already Ready: that unmounts RouteView and
            // tears down interactive roots while Blazor's enhanced navigation still runs refreshRootComponents,
            // which throws "Cannot send data if the connection is not in the 'Connected' State" and leaves
            // loading indicators stuck (e.g. MudTable ServerData).
            if (_phase != GuardPhase.Ready)
                _phase = GuardPhase.Checking;

            var relative = Navigation.ToBaseRelativePath(Navigation.Uri);

            // Database-free routes must not touch the database at all: the login page is
            // served to unauthenticated visitors and must work even when the database is down.
            if (DbRoutes.IsDatabaseFreeRoute(relative))
            {
                _scope = null;
                _phase = GuardPhase.Ready;
                return;
            }

            var status = await Readiness.GetStatusAsync(ct);

            if (ct.IsCancellationRequested)
                return;

            if (!status.IsReady)
            {
                _phase = GuardPhase.Redirecting;
                Navigation.NavigateTo(DbRoutes.DatabaseMigration, replace: true);
                return;
            }

            if (!await ResolveScopeAsync(relative, ct))
                return;

            _phase = GuardPhase.Ready;
        }
        catch (OperationCanceledException)
        {
            // Component disposed mid-flight; swallow and exit cleanly.
        }
        finally
        {
            if (!_cts.IsCancellationRequested)
                _guardRunLock.Release();
            else
            {
                try { _guardRunLock.Release(); } catch (ObjectDisposedException) { }
            }
        }
    }

    /// <summary>
    /// Loads the database named in the URL. Returns false when the caller should stop because a
    /// redirect is already under way — a URL naming a database that no longer exists goes back to
    /// the picker rather than rendering a page full of empty lists.
    /// </summary>
    private async Task<bool> ResolveScopeAsync(string relativePath, CancellationToken ct)
    {
        var dbId = DbRoutes.TryGetDatabaseId(relativePath);
        if (dbId is null)
        {
            _scope = null;
            return true;
        }

        if (_scope?.Id == dbId.Value)
            return true;

        await using var db = await DbContextFactory.CreateDbContextAsync(ct);
        var id = (DatabaseConnectionId)dbId.Value;
        var row = await db.DatabaseConnections.AsNoTracking()
            .Where(c => c.Id == id)
            .Select(c => new
            {
                c.Name,
                c.AnalyzeOnly,
                c.AIConnectionId,
                AiName = c.AIConnection != null ? c.AIConnection.Name : null
            })
            .FirstOrDefaultAsync(ct);

        if (row is null)
        {
            _scope = null;
            _phase = GuardPhase.Redirecting;
            Navigation.NavigateTo(DbRoutes.SelectDatabase, replace: true);
            return false;
        }

        _scope = new DatabaseScope(
            dbId.Value,
            row.Name,
            row.AnalyzeOnly,
            row.AIConnectionId is { } aiId ? (int)(object)aiId : null,
            row.AiName);
        return true;
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        ScopeNotifier.ScopeChanged -= OnScopeChangedAsync;
        _cts.Cancel();
        _cts.Dispose();
        _guardRunLock.Dispose();
    }

    private enum GuardPhase
    {
        Checking,
        Redirecting,
        Ready
    }
}
