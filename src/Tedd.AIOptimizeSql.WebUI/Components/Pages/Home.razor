@page "/"
@rendermode InteractiveServer

<PageTitle>AI SQL Optimizer</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h3" GutterBottom="true">AI SQL Optimizer</MudText>
    <MudText Typo="Typo.body1" Class="mb-2">
        Optimize your SQL Server databases using AI-powered analysis, hypothesis testing, and benchmarking.
    </MudText>
    <MudText Typo="Typo.body1" Class="mb-4">
        Follow the steps in order: connect a database, connect an AI, analyze the database, then run experiments.
    </MudText>

    <MudAlert Severity="Severity.Warning" Class="mb-6" Elevation="1">
        Experiments apply real changes to the target database while testing (and revert them afterwards).
        Do not point this tool at a production database — use a copy or a test environment.
    </MudAlert>

    <MudGrid>
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="3" Class="rounded-lg" Style="height: 100%; display: flex; flex-direction: column;">
                <MudCardHeader>
                    <CardHeaderAvatar>
                        <MudAvatar Color="Color.Primary" Variant="Variant.Filled">1</MudAvatar>
                    </CardHeaderAvatar>
                    <CardHeaderContent>
                        <MudText Typo="Typo.overline">Step 1</MudText>
                        <MudText Typo="Typo.h6">Database Connection</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Style="flex-grow: 1;">
                    <MudText Typo="Typo.body2">
                        Add a connection to the SQL Server database you want to analyze and optimize.
                    </MudText>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Storage" Href="/database-connections">
                        Add database
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="3" Class="rounded-lg" Style="height: 100%; display: flex; flex-direction: column;">
                <MudCardHeader>
                    <CardHeaderAvatar>
                        <MudAvatar Color="Color.Secondary" Variant="Variant.Filled">2</MudAvatar>
                    </CardHeaderAvatar>
                    <CardHeaderContent>
                        <MudText Typo="Typo.overline">Step 2</MudText>
                        <MudText Typo="Typo.h6">AI Connection</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Style="flex-grow: 1;">
                    <MudText Typo="Typo.body2">
                        Configure the AI provider and model that will analyze and optimize your database.
                    </MudText>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.SmartToy" Href="/ai-connections">
                        Add AI
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="3" Class="rounded-lg" Style="height: 100%; display: flex; flex-direction: column;">
                <MudCardHeader>
                    <CardHeaderAvatar>
                        <MudAvatar Color="Color.Info" Variant="Variant.Filled">3</MudAvatar>
                    </CardHeaderAvatar>
                    <CardHeaderContent>
                        <MudText Typo="Typo.overline">Step 3</MudText>
                        <MudText Typo="Typo.h6">Database Analysis</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Style="flex-grow: 1;">
                    <MudText Typo="Typo.body2">
                        Run a read-only AI health check: missing indexes, fragmentation, expensive queries,
                        and configuration issues — with findings and proposed experiments.
                    </MudText>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" Color="Color.Info" StartIcon="@Icons.Material.Filled.MonitorHeart" Href="/analyses">
                        Run analysis
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="3" Class="rounded-lg" Style="height: 100%; display: flex; flex-direction: column;">
                <MudCardHeader>
                    <CardHeaderAvatar>
                        <MudAvatar Color="Color.Tertiary" Variant="Variant.Filled">4</MudAvatar>
                    </CardHeaderAvatar>
                    <CardHeaderContent>
                        <MudText Typo="Typo.overline">Step 4</MudText>
                        <MudText Typo="Typo.h6">Experiments</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Style="flex-grow: 1;">
                    <MudText Typo="Typo.body2">
                        Optimize a specific query: the AI proposes hypotheses, applies them, benchmarks
                        against a baseline, and reverts — building on what works.
                    </MudText>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.Tune" Href="/experiments">
                        Run experiments
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>

    <MudText Typo="Typo.h6" Class="mt-8 mb-2">Follow up</MudText>
    <MudGrid>
        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="2" Class="rounded-lg">
                <MudCardHeader>
                    <CardHeaderAvatar>
                        <MudAvatar Color="Color.Primary" Variant="Variant.Outlined">
                            <MudIcon Icon="@Icons.Material.Filled.BatchPrediction" />
                        </MudAvatar>
                    </CardHeaderAvatar>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Research iterations</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudText Typo="Typo.body2">Review all research iterations, queue state, and results across experiments.</MudText>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/research-iterations">
                        View iterations
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="2" Class="rounded-lg">
                <MudCardHeader>
                    <CardHeaderAvatar>
                        <MudAvatar Color="Color.Default" Variant="Variant.Outlined">
                            <MudIcon Icon="@Icons.Material.Filled.MenuBook" />
                        </MudAvatar>
                    </CardHeaderAvatar>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Documentation</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudText Typo="Typo.body2">The full user guide: analyses, experiments, iterations, hypotheses, and benchmark runs.</MudText>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" Href="/documentation">
                        Read the guide
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudContainer>
