@page "/db/{DbId:int}/experiments/new"
@page "/db/{DbId:int}/experiments/{Id:int}/edit"
@implements IDisposable
@rendermode InteractiveServer
@inject IDbContextFactory<Tedd.AIOptimizeSql.Database.AIOptimizeDbContext> DbContextFactory
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IExperimentBlueprintService BlueprintService
@inject ISandboxScriptService SandboxScriptService
@using Microsoft.EntityFrameworkCore
@using Tedd.AIOptimizeSql.Database
@using Tedd.AIOptimizeSql.Database.Models
@using Tedd.AIOptimizeSql.Database.Models.Enums
@using Tedd.AIOptimizeSql.OptimizeEngine.Models.SqlBrowser
@using Tedd.AIOptimizeSql.OptimizeEngine.Services.SqlBrowser

<PageTitle>@(_isNew ? "New" : "Edit") Experiment</PageTitle>

<EditNavigationGuard HasUnsavedChanges="@(() => IsModified)"
                     TrySaveAsync="TryPersistAsync"
                     DiscardAsync="DiscardAsync" />

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
    <HierarchyBreadcrumbs DbId="@DbId" ExperimentId="@(_isNew ? null : Id)" ShowIterationList="false"
                          Leaf="@(_isNew ? "New experiment" : "Edit")" />

    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="GoBack" />
        <MudText Typo="Typo.h4">@(_isNew ? "New" : "Edit") Experiment</MudText>
    </MudStack>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_model == null)
    {
        <MudAlert Severity="Severity.Error">Experiment not found.</MudAlert>
    }
    else
    {
        <MudCard Elevation="3" Class="rounded-lg">
            <MudCardContent>
                <MudForm @ref="_form" @bind-IsValid="_formValid">
                    <MudTabs @bind-ActivePanelIndex="_activeTabIndex" Rounded="true" Border="true" Class="mb-2">
                        <MudTabPanel Text="Details">
                            <MudStack Spacing="0" Class="pt-4">
                                <MudTextField @bind-Value="_model.Name" Label="Name" Required="true"
                                              RequiredError="Name is required" MaxLength="1024"
                                              Variant="Variant.Outlined" Class="mb-4" />

                                <MudTextField @bind-Value="_model.Description" Label="Description"
                                              Lines="2" Variant="Variant.Outlined" Class="mb-4"
                                              HelperText="Human-readable description (not used by AI)" />

                                <MudTextField Value="@(Db?.Name ?? $"#{DbId}")" Label="Database" ReadOnly="true"
                                              Variant="Variant.Outlined" Class="mb-4"
                                              HelperText="The database you are working in. Switch database to target another one." />

                                <MudSelect T="AIConnectionId?" @bind-Value="_selectedAiConnId" Label="AI Connection"
                                           Variant="Variant.Outlined" Class="mb-4" Clearable="true"
                                           HelperText="Defaults to the AI bound to this database.">
                                    @foreach (var conn in _aiConnections)
                                    {
                                        <MudSelectItem Value="@((AIConnectionId?)conn.Id)">@conn.Name (@conn.Provider / @conn.Model)</MudSelectItem>
                                    }
                                </MudSelect>

                                <MudTextField @bind-Value="_model.Instructions" Label="AI Instructions"
                                              Lines="3" Variant="Variant.Outlined" Class="mb-4"
                                              HelperText="Instructions for the AI optimizer" />

                                @if (!_isNew)
                                {
                                    <MudStack Row="true" Spacing="4" Class="mb-4">
                                        <MudText Typo="Typo.caption">Created: @_model.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudText>
                                        <MudText Typo="Typo.caption">Modified: @_model.ModifiedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudText>
                                    </MudStack>
                                }

                                @TabActions(showResearchIterationsLink: true)
                            </MudStack>
                        </MudTabPanel>

                        <MudTabPanel Text="SQL">
                            <MudStack Spacing="0" Class="pt-4">
                                <SqlMonacoField EditorId="@_editorIdBenchmark"
                                                Label="Benchmark SQL"
                                                HelperText="SQL used to measure performance (required for experiments)."
                                                Value="@_model.BenchmarkSql"
                                                ValueChanged="OnBenchmarkSqlChanged"
                                                Required="true"
                                                RequiredError="Benchmark SQL is required"
                                                ValidationAttempted="_benchmarkValidationAttempted" />

                                <MudText Typo="Typo.subtitle2" Class="mb-2 mt-2">Hypothesis SQL</MudText>
                                <SqlMonacoField EditorId="@_editorIdHypothesisPre"
                                                Label="Hypothesis Pre-Run SQL"
                                                HelperText="Executed before each hypothesis"
                                                @bind-Value="_model.HypothesisPreRunSql" />

                                <SqlMonacoField EditorId="@_editorIdHypothesisPost"
                                                Label="Hypothesis Post-Run SQL"
                                                HelperText="Executed after each hypothesis"
                                                @bind-Value="_model.HypothesisPostRunSql" />

                                <MudText Typo="Typo.subtitle2" Class="mb-2 mt-2">Experiment SQL</MudText>
                                <SqlMonacoField EditorId="@_editorIdExperimentPre"
                                                Label="Pre-Run SQL"
                                                HelperText="Executed before optimization starts"
                                                @bind-Value="_model.ExperimentPreRunSql" />

                                <SqlMonacoField EditorId="@_editorIdExperimentPost"
                                                Label="Post-Run SQL"
                                                HelperText="Executed after each run"
                                                @bind-Value="_model.ExperimentPostRunSql" />

                                @TabActions(showResearchIterationsLink: false)
                            </MudStack>
                        </MudTabPanel>

                        <MudTabPanel Text="Isolation &amp; verification">
                            <MudStack Spacing="0" Class="pt-4">
                                <MudText Typo="Typo.subtitle2" Class="mb-2">Where it runs</MudText>
                                <MudSelect T="ExperimentIsolationMode" @bind-Value="_model.IsolationMode" Label="Isolation mode"
                                           Variant="Variant.Outlined" Class="mb-4"
                                           HelperText="None runs against the database as-is. SandboxSchema copies the touched objects into a separate schema. CloneDatabase runs against a separate database on the same server.">
                                    <MudSelectItem Value="ExperimentIsolationMode.None">None (run in place)</MudSelectItem>
                                    <MudSelectItem Value="ExperimentIsolationMode.SandboxSchema">Sandbox schema</MudSelectItem>
                                    <MudSelectItem Value="ExperimentIsolationMode.CloneDatabase">Clone database</MudSelectItem>
                                </MudSelect>

                                @if (_model.IsolationMode != ExperimentIsolationMode.None)
                                {
                                    @if (_model.IsolationMode == ExperimentIsolationMode.SandboxSchema)
                                    {
                                        <MudTextField @bind-Value="_model.SandboxSchemaName" Label="Sandbox schema name"
                                                      Variant="Variant.Outlined" Class="mb-4" MaxLength="128"
                                                      HelperText="The copies live in this schema of the target database." />
                                    }
                                    else
                                    {
                                        <MudTextField @bind-Value="_model.SandboxDatabaseName" Label="Sandbox database name"
                                                      Variant="Variant.Outlined" Class="mb-4" MaxLength="128"
                                                      HelperText="The clone is created on the same server under this name, and dropped again on teardown." />
                                    }

                                    <MudStack Row="true" Spacing="2" Class="mb-3 flex-wrap">
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                                   StartIcon="@Icons.Material.Filled.AutoFixHigh"
                                                   Disabled="@_sandboxBusy" OnClick="@(() => GenerateSandboxAsync(withAi: false))">
                                            @(_sandboxGenerating ? "Generating..." : "Generate scripts")
                                        </MudButton>
                                        <MudTooltip Text="Pick an AI connection on the Details tab to enable this."
                                                    Disabled="@(_selectedAiConnId is not null)">
                                            <MudButton Variant="Variant.Outlined"
                                                       StartIcon="@Icons.Material.Filled.AutoAwesome"
                                                       Disabled="@(_sandboxBusy || _selectedAiConnId is null)"
                                                       OnClick="@(() => GenerateSandboxAsync(withAi: true))">
                                                @(_sandboxAiRunning ? "Working..." : "Complete with AI")
                                            </MudButton>
                                        </MudTooltip>
                                    </MudStack>

                                    <MudText Typo="Typo.caption" Class="d-block mb-3">
                                        Generation reads the target database's catalog and the benchmark SQL: the tables the
                                        benchmark touches are recreated with their real keys, indexes and defaults, filled from
                                        the source, and — for a clone database — the views, functions and procedures it calls are
                                        copied too.
                                    </MudText>

                                    @if (_sandboxGenerating || _sandboxAiRunning)
                                    {
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                                            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                                            <MudText Typo="Typo.body2">@_sandboxProgress</MudText>
                                        </MudStack>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(_sandboxSummary))
                                    {
                                        <MudAlert Severity="Severity.Success" Dense="true" Class="mb-3">@_sandboxSummary</MudAlert>
                                    }
                                    @if (_sandboxWarnings.Count > 0)
                                    {
                                        <MudAlert Severity="Severity.Warning" Class="mb-3">
                                            <MudText Typo="Typo.subtitle2">The generator could not do everything:</MudText>
                                            <ul class="ml-4">
                                                @foreach (var w in _sandboxWarnings)
                                                {
                                                    <li>@w</li>
                                                }
                                            </ul>
                                        </MudAlert>
                                    }

                                    <SqlMonacoField EditorId="@_editorIdSandboxSetup"
                                                    Label="Sandbox setup SQL"
                                                    HelperText="Runs once, before schema discovery and the baseline benchmark."
                                                    @bind-Value="_model.SandboxSetupSql" />

                                    <SqlMonacoField EditorId="@_editorIdSandboxTeardown"
                                                    Label="Sandbox teardown SQL"
                                                    HelperText="Runs when the iteration finishes, including after a failure."
                                                    @bind-Value="_model.SandboxTeardownSql" />
                                }

                                <MudText Typo="Typo.subtitle2" Class="mb-2 mt-4">Proving the result is identical</MudText>
                                <MudSelect T="OutputVerificationMode" @bind-Value="_model.OutputVerificationMode" Label="Output verification"
                                           Variant="Variant.Outlined" Class="mb-4"
                                           HelperText="Fingerprints the benchmark query's output so a hypothesis can be proven to return the same rows, not just measured as faster.">
                                    <MudSelectItem Value="OutputVerificationMode.None">None (measure speed only)</MudSelectItem>
                                    <MudSelectItem Value="OutputVerificationMode.UnorderedHash">Unordered hash (ignores row order)</MudSelectItem>
                                    <MudSelectItem Value="OutputVerificationMode.OrderedHash">Ordered hash (row order must match)</MudSelectItem>
                                </MudSelect>

                                @if (_model.OutputVerificationMode != OutputVerificationMode.None)
                                {
                                    <SqlMonacoField EditorId="@_editorIdOutputVerification"
                                                    Label="Output verification SQL"
                                                    HelperText="Must return exactly one row with one column, used as the fingerprint."
                                                    @bind-Value="_model.OutputVerificationSql" />
                                }

                                @TabActions(showResearchIterationsLink: false)
                            </MudStack>
                        </MudTabPanel>
                    </MudTabs>
                </MudForm>
            </MudCardContent>
        </MudCard>
    }
</MudContainer>

@code {
    [Parameter] public int DbId { get; set; }

    [Parameter] public int? Id { get; set; }

    [CascadingParameter] private DatabaseScope? Db { get; set; }

    private DatabaseConnectionId ScopeId => (DatabaseConnectionId)DbId;

    private Experiment? _model;
    private bool _isNew;
    private bool _loading = true;
    private bool _formValid;
    private int _activeTabIndex;
    private MudForm? _form;
    private List<AIConnection> _aiConnections = new();
    private AIConnectionId? _selectedAiConnId;
    private readonly CancellationTokenSource _pageCts = new();
    private AIOptimizeDbContext? _db;
    private bool _benchmarkValidationAttempted;

    private string _editorIdBenchmark = "";
    private string _editorIdHypothesisPre = "";
    private string _editorIdHypothesisPost = "";
    private string _editorIdExperimentPre = "";
    private string _editorIdExperimentPost = "";
    private string _editorIdSandboxSetup = "";
    private string _editorIdSandboxTeardown = "";
    private string _editorIdOutputVerification = "";

    private const int LastTabIndex = 2;

    private bool CanSave =>
        _formValid && !string.IsNullOrWhiteSpace(_model?.BenchmarkSql);

    private string _baselineName = "";
    private string _baselineDescription = "";
    private string _baselineInstructions = "";
    private string _baselineHypothesisPreRunSql = "";
    private string _baselineHypothesisPostRunSql = "";
    private string _baselineExperimentPreRunSql = "";
    private string _baselineExperimentPostRunSql = "";
    private string _baselineBenchmarkSql = "";
    private AIConnectionId? _baselineAiConnId;
    private ExperimentIsolationMode _baselineIsolationMode;
    private string _baselineSandboxSchemaName = "";
    private string _baselineSandboxDatabaseName = "";
    private string _baselineSandboxSetupSql = "";
    private string _baselineSandboxTeardownSql = "";
    private OutputVerificationMode _baselineOutputVerificationMode;
    private string _baselineOutputVerificationSql = "";

    private bool IsModified =>
        !_loading && _model != null &&
        (_model.Name != _baselineName ||
         (_model.Description ?? "") != _baselineDescription ||
         (_model.Instructions ?? "") != _baselineInstructions ||
         (_model.HypothesisPreRunSql ?? "") != _baselineHypothesisPreRunSql ||
         (_model.HypothesisPostRunSql ?? "") != _baselineHypothesisPostRunSql ||
         (_model.ExperimentPreRunSql ?? "") != _baselineExperimentPreRunSql ||
         (_model.ExperimentPostRunSql ?? "") != _baselineExperimentPostRunSql ||
         (_model.BenchmarkSql ?? "") != _baselineBenchmarkSql ||
         _selectedAiConnId != _baselineAiConnId ||
         _model.IsolationMode != _baselineIsolationMode ||
         (_model.SandboxSchemaName ?? "") != _baselineSandboxSchemaName ||
         (_model.SandboxDatabaseName ?? "") != _baselineSandboxDatabaseName ||
         (_model.SandboxSetupSql ?? "") != _baselineSandboxSetupSql ||
         (_model.SandboxTeardownSql ?? "") != _baselineSandboxTeardownSql ||
         _model.OutputVerificationMode != _baselineOutputVerificationMode ||
         (_model.OutputVerificationSql ?? "") != _baselineOutputVerificationSql);

    private void CaptureBaseline()
    {
        if (_model == null) return;
        _baselineName = _model.Name;
        _baselineDescription = _model.Description ?? "";
        _baselineInstructions = _model.Instructions ?? "";
        _baselineHypothesisPreRunSql = _model.HypothesisPreRunSql ?? "";
        _baselineHypothesisPostRunSql = _model.HypothesisPostRunSql ?? "";
        _baselineExperimentPreRunSql = _model.ExperimentPreRunSql ?? "";
        _baselineExperimentPostRunSql = _model.ExperimentPostRunSql ?? "";
        _baselineBenchmarkSql = _model.BenchmarkSql ?? "";
        _baselineAiConnId = _selectedAiConnId;
        _baselineIsolationMode = _model.IsolationMode;
        _baselineSandboxSchemaName = _model.SandboxSchemaName ?? "";
        _baselineSandboxDatabaseName = _model.SandboxDatabaseName ?? "";
        _baselineSandboxSetupSql = _model.SandboxSetupSql ?? "";
        _baselineSandboxTeardownSql = _model.SandboxTeardownSql ?? "";
        _baselineOutputVerificationMode = _model.OutputVerificationMode;
        _baselineOutputVerificationSql = _model.OutputVerificationSql ?? "";
    }

    private RenderFragment TabActions(bool showResearchIterationsLink) => __builder =>
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-4 flex-wrap" Style="gap: 8px;">
            @if (showResearchIterationsLink && !_isNew)
            {
                <MudButton Variant="Variant.Text" Color="Color.Info"
                           Href="@DbRoutes.ExperimentIterations(DbId, Id!.Value)" StartIcon="@Icons.Material.Filled.PlayArrow">
                    View research iterations
                </MudButton>
            }
            <MudSpacer />
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.NavigateBefore"
                       Disabled="@(_activeTabIndex == 0)"
                       OnClick="@(() => _activeTabIndex = Math.Max(0, _activeTabIndex - 1))">
                Previous
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       EndIcon="@Icons.Material.Filled.NavigateNext"
                       Disabled="@(_activeTabIndex == LastTabIndex)"
                       OnClick="@(() => _activeTabIndex = Math.Min(LastTabIndex, _activeTabIndex + 1))">
                Next
            </MudButton>
            <MudButton Variant="Variant.Text" OnClick="DiscardAsync" Disabled="@_discardBusy">
                Discard
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!CanSave)"
                       OnClick="Save" StartIcon="@Icons.Material.Filled.Save">
                Save
            </MudButton>
        </MudStack>
    };

    private bool _discardBusy;

    private bool _sandboxGenerating;
    private bool _sandboxAiRunning;
    private string _sandboxProgress = "";
    private string? _sandboxSummary;
    private List<string> _sandboxWarnings = new();

    private bool _sandboxBusy => _sandboxGenerating || _sandboxAiRunning;

    /// <summary>
    /// Writes the sandbox setup and teardown scripts from the target database's catalog. The
    /// benchmark SQL is analyzed first, because which tables the sandbox has to contain is a
    /// property of the query, not something the edit form can know on its own.
    /// </summary>
    private async Task GenerateSandboxAsync(bool withAi)
    {
        if (_model is null || _sandboxBusy)
            return;

        var dbConn = await _db!.DatabaseConnections.AsNoTracking()
            .FirstOrDefaultAsync(c => c.Id == ScopeId, _pageCts.Token);
        if (dbConn is null)
        {
            Snackbar.Add("This database connection no longer exists.", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(_model.BenchmarkSql))
        {
            Snackbar.Add("Benchmark SQL is required: it decides which tables the sandbox has to contain.", Severity.Warning);
            _activeTabIndex = 1;
            return;
        }

        var aiConn = withAi ? _aiConnections.FirstOrDefault(c => c.Id == _selectedAiConnId) : null;
        if (withAi && aiConn is null)
            return;

        if (_model.IsolationMode == ExperimentIsolationMode.SandboxSchema && string.IsNullOrWhiteSpace(_model.SandboxSchemaName))
            _model.SandboxSchemaName = $"aiopt_sandbox_{Guid.NewGuid().ToString("N")[..8]}";
        else if (_model.IsolationMode == ExperimentIsolationMode.CloneDatabase && string.IsNullOrWhiteSpace(_model.SandboxDatabaseName))
            _model.SandboxDatabaseName = $"{dbConn.Name}_Sandbox_{Guid.NewGuid().ToString("N")[..8]}";

        if (withAi) _sandboxAiRunning = true; else _sandboxGenerating = true;
        _sandboxProgress = "Analyzing the benchmark...";
        _sandboxSummary = null;
        _sandboxWarnings = new();
        await InvokeAsync(StateHasChanged);

        var progress = new Progress<string>(msg =>
        {
            _sandboxProgress = msg;
            _ = InvokeAsync(StateHasChanged);
        });

        try
        {
            var (blueprint, _, _) = await BlueprintService.AnalyzeQueryAsync(
                dbConn.ConnectionString, _model.BenchmarkSql!, _pageCts.Token);

            var request = new SandboxScriptRequest
            {
                IsolationMode = _model.IsolationMode,
                SandboxSchemaName = _model.SandboxSchemaName,
                SandboxDatabaseName = _model.SandboxDatabaseName,
                BenchmarkSql = _model.BenchmarkSql!,
                Tables = blueprint.BaseTables
            };

            var scripts = aiConn is not null
                ? await SandboxScriptService.GenerateWithAiAsync(
                    aiConn, dbConn.ConnectionString, request, progress, _pageCts.Token)
                : await SandboxScriptService.GenerateAsync(dbConn.ConnectionString, request, _pageCts.Token);

            _sandboxSummary = scripts.Summary;
            _sandboxWarnings = scripts.Warnings.ToList();

            if (string.IsNullOrWhiteSpace(scripts.Setup))
            {
                // A refusal — a sandbox name that collides with something real — explains itself
                // through the warnings; overwriting the editors with nothing would only hide it.
                Snackbar.Add("No scripts were generated. See the warnings above.", Severity.Warning);
                return;
            }

            _model.SandboxSetupSql = scripts.Setup;
            _model.SandboxTeardownSql = scripts.Teardown;
            Snackbar.Add("Sandbox scripts generated. Review them, then Save.", Severity.Success);
        }
        catch (OperationCanceledException)
        {
            // Navigating away.
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not generate the sandbox scripts: {ex.Message}", Severity.Error);
        }
        finally
        {
            _sandboxGenerating = false;
            _sandboxAiRunning = false;
        }
    }

    public void Dispose()
    {
        _pageCts.Cancel();
        _pageCts.Dispose();
        _db?.Dispose();
        _db = null;
    }

    protected override Task OnInitializedAsync() =>
        PageLoadCancellation.RunPageLoadAsync(async ct =>
        {
            _db = await DbContextFactory.CreateDbContextAsync(ct);
            _aiConnections = await _db.AIConnections.OrderBy(c => c.Name).ToListAsync(ct);

            if (Id.HasValue)
            {
                _isNew = false;
                var id = (ExperimentId)(object)Id.Value;
                _model = await _db.Experiments.AsNoTracking()
                    .Include(p => p.AIConnection)
                    .FirstOrDefaultAsync(p => p.Id == id && p.DatabaseConnectionId == ScopeId, ct);
                if (_model != null)
                    _selectedAiConnId = _model.AIConnectionId;
            }
            else
            {
                _isNew = true;
                _model = new Experiment { Name = "", DatabaseConnectionId = ScopeId };
                // Inherited from the database, which is the whole point of binding an AI to it.
                _selectedAiConnId = Db?.TypedAiConnectionId;
            }

            var key = Id?.ToString() ?? "new";
            _editorIdBenchmark = $"experiment-edit-benchmark-{key}";
            _editorIdHypothesisPre = $"experiment-edit-hypothesis-pre-{key}";
            _editorIdHypothesisPost = $"experiment-edit-hypothesis-post-{key}";
            _editorIdExperimentPre = $"experiment-edit-experiment-pre-{key}";
            _editorIdExperimentPost = $"experiment-edit-experiment-post-{key}";
            _editorIdSandboxSetup = $"experiment-edit-sandbox-setup-{key}";
            _editorIdSandboxTeardown = $"experiment-edit-sandbox-teardown-{key}";
            _editorIdOutputVerification = $"experiment-edit-output-verification-{key}";

            _loading = false;
            CaptureBaseline();
        }, _pageCts.Token);

    private Task OnBenchmarkSqlChanged(string? value)
    {
        if (_model == null) return Task.CompletedTask;
        _model.BenchmarkSql = value;
        if (!string.IsNullOrWhiteSpace(value))
            _benchmarkValidationAttempted = false;
        return Task.CompletedTask;
    }

    private async Task DiscardAsync()
    {
        if (_db is null || _model == null || _discardBusy) return;
        _discardBusy = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            if (_isNew)
            {
                _model = new Experiment { Name = "", DatabaseConnectionId = ScopeId };
                _selectedAiConnId = Db?.TypedAiConnectionId;
            }
            else
            {
                var experimentId = _model.Id;
                _model = await _db.Experiments.AsNoTracking()
                    .Include(p => p.AIConnection)
                    .FirstOrDefaultAsync(p => p.Id == experimentId, _pageCts.Token);
                if (_model == null)
                {
                    Snackbar.Add("Experiment not found.", Severity.Error);
                    return;
                }
                _selectedAiConnId = _model.AIConnectionId;
            }
            Snackbar.Add("Changes discarded.", Severity.Info);
            _benchmarkValidationAttempted = false;
            CaptureBaseline();
        }
        finally
        {
            _discardBusy = false;
        }
    }

    private async Task<bool> TryPersistAsync()
    {
        if (_db is null || _model == null) return false;
        await _form!.ValidateAsync();
        if (!_formValid) return false;

        if (string.IsNullOrWhiteSpace(_model.BenchmarkSql))
        {
            _benchmarkValidationAttempted = true;
            _activeTabIndex = 1;
            await InvokeAsync(StateHasChanged);
            Snackbar.Add("Benchmark SQL is required.", Severity.Warning);
            return false;
        }

        _model.DatabaseConnectionId = ScopeId;
        _model.AIConnectionId = _selectedAiConnId;

        if (_isNew)
        {
            _model.CreatedAt = DateTime.UtcNow;
            _model.ModifiedAt = DateTime.UtcNow;
            _db.Experiments.Add(_model);
            await _db.SaveChangesAsync();
            _db.ChangeTracker.Clear();
        }
        else
        {
            var id = _model.Id;
            var now = DateTime.UtcNow;
            var n = await _db.Experiments.Where(p => p.Id == id).ExecuteUpdateAsync(s => s
                .SetProperty(p => p.Name, _model.Name)
                .SetProperty(p => p.Description, _model.Description)
                .SetProperty(p => p.Instructions, _model.Instructions)
                .SetProperty(p => p.ExperimentPreRunSql, _model.ExperimentPreRunSql)
                .SetProperty(p => p.ExperimentPostRunSql, _model.ExperimentPostRunSql)
                .SetProperty(p => p.HypothesisPreRunSql, _model.HypothesisPreRunSql)
                .SetProperty(p => p.HypothesisPostRunSql, _model.HypothesisPostRunSql)
                .SetProperty(p => p.BenchmarkSql, _model.BenchmarkSql)
                .SetProperty(p => p.AIConnectionId, _selectedAiConnId)
                .SetProperty(p => p.IsolationMode, _model.IsolationMode)
                .SetProperty(p => p.SandboxSchemaName, _model.SandboxSchemaName)
                .SetProperty(p => p.SandboxDatabaseName, _model.SandboxDatabaseName)
                .SetProperty(p => p.SandboxSetupSql, _model.SandboxSetupSql)
                .SetProperty(p => p.SandboxTeardownSql, _model.SandboxTeardownSql)
                .SetProperty(p => p.OutputVerificationMode, _model.OutputVerificationMode)
                .SetProperty(p => p.OutputVerificationSql, _model.OutputVerificationSql)
                .SetProperty(p => p.ModifiedAt, now));
            if (n != 1)
            {
                Snackbar.Add("Experiment not found or was deleted.", Severity.Error);
                return false;
            }

            _model.ModifiedAt = now;
        }
        Snackbar.Add(_isNew ? "Experiment created" : "Experiment saved", Severity.Success);
        CaptureBaseline();
        return true;
    }

    private async Task Save()
    {
        if (!await TryPersistAsync()) return;
        Navigation.NavigateTo(DbRoutes.Experiments(DbId));
    }

    private void GoBack() => Navigation.NavigateTo(DbRoutes.Experiments(DbId));
}
