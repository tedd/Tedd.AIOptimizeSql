@page "/experiments/{Id:int}/view"
@implements IDisposable
@rendermode InteractiveServer
@inject IDbContextFactory<Tedd.AIOptimizeSql.Database.AIOptimizeDbContext> DbContextFactory
@inject IAIOptimizeDataAccess DataAccess
@inject IOptions<UiPollingOptions> UiPolling
@inject NavigationManager Navigation
@using Microsoft.EntityFrameworkCore
@using Tedd.AIOptimizeSql.Database
@using Tedd.AIOptimizeSql.Database.Models

<PageTitle>Experiment results</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => Navigation.NavigateTo("/experiments"))" aria-label="Back to experiments" />
        <MudText Typo="Typo.h4">@(_experiment?.Name ?? "Experiment")</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit"
                   Href="@($"/experiments/{Id}/edit")">
            Edit
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Search"
                   Href="@($"/experiments/{Id}/research-iterations")">
            Iterations
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddCircle"
                   Href="@($"/experiments/{Id}/research-iterations/new")">
            New Iteration
        </MudButton>
    </MudStack>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_experiment == null)
    {
        <MudAlert Severity="Severity.Error">Experiment not found.</MudAlert>
    }
    else
    {
        <MudTabs @bind-ActivePanelIndex="_activeTabIndex" Rounded="true" Border="true" Class="mb-2">
            <MudTabPanel Text="Results">
                <MudStack Spacing="0" Class="pt-4">
                    <MudCard Elevation="2" Class="rounded-lg mb-4">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6">Experiment</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudStack Spacing="2">
                                @if (!string.IsNullOrWhiteSpace(_experiment.Description))
                                {
                                    <div>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Description</MudText>
                                        <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">@_experiment.Description</MudText>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(_experiment.Instructions))
                                {
                                    <div>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">AI instructions</MudText>
                                        <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">@_experiment.Instructions</MudText>
                                    </div>
                                }
                                <MudStack Row="true" Spacing="6" Wrap="Wrap.Wrap">
                                    <div>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Database connection</MudText>
                                        <MudText Typo="Typo.body2">@(_experiment.DatabaseConnection?.Name ?? "—")</MudText>
                                    </div>
                                    <div>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">AI connection</MudText>
                                        <MudText Typo="Typo.body2">
                                            @if (_experiment.AIConnection is { } ai)
                                            {
                                                @($"{ai.Name} ({ai.Provider} / {ai.Model})")
                                            }
                                            else
                                            {
                                                <text>—</text>
                                            }
                                        </MudText>
                                    </div>
                                </MudStack>
                                <MudStack Row="true" Spacing="4" Wrap="Wrap.Wrap">
                                    <MudText Typo="Typo.caption">Created @_experiment.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudText>
                                    <MudText Typo="Typo.caption">Modified @_experiment.ModifiedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudText>
                                </MudStack>
                            </MudStack>
                        </MudCardContent>
                    </MudCard>

                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                        Elapsed time uses SQL Server reported <strong>total server elapsed time (ms)</strong> from each hypothesis&rsquo;s benchmark runs.
                        Improvement is measured against the iteration&rsquo;s baseline benchmark.
                    </MudText>

                    @if (_totalHypotheses > 0)
                    {
                        <MudGrid Spacing="3" Class="mb-2">
                            <MudItem xs="6" sm="3">
                                <MudPaper Elevation="2" Class="pa-4 rounded-lg">
                                    <MudText Typo="Typo.overline">Hypotheses tested</MudText>
                                    <MudText Typo="Typo.h4">@_totalHypotheses</MudText>
                                    <MudText Typo="Typo.caption">@_orderedIterations.Count iteration(s)</MudText>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="6" sm="3">
                                <MudPaper Elevation="2" Class="pa-4 rounded-lg">
                                    <MudText Typo="Typo.overline">Best improvement</MudText>
                                    <MudText Typo="Typo.h4" Color="@(_bestImprovement > 0 ? Color.Success : Color.Default)">
                                        @(_bestImprovement > 0 ? $"+{_bestImprovement:0.#}%" : "—")
                                    </MudText>
                                    <MudText Typo="Typo.caption" Style="max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: block;">
                                        @(_bestHypothesisTitle ?? "no successful hypothesis yet")
                                    </MudText>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="6" sm="3">
                                <MudPaper Elevation="2" Class="pa-4 rounded-lg">
                                    <MudText Typo="Typo.overline">Improved / regressed</MudText>
                                    <MudStack Row="true" AlignItems="AlignItems.Baseline" Spacing="1">
                                        <MudText Typo="Typo.h4" Color="Color.Success">@_improvedCount</MudText>
                                        <MudText Typo="Typo.h6" Color="Color.Secondary">/</MudText>
                                        <MudText Typo="Typo.h4" Color="Color.Error">@_regressedCount</MudText>
                                    </MudStack>
                                    <MudText Typo="Typo.caption">&gt;5% better / &gt;5% worse</MudText>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="6" sm="3">
                                <MudPaper Elevation="2" Class="pa-4 rounded-lg">
                                    <MudText Typo="Typo.overline">Failed</MudText>
                                    <MudText Typo="Typo.h4" Color="@(_failedCount > 0 ? Color.Warning : Color.Default)">@_failedCount</MudText>
                                    <MudText Typo="Typo.caption">could not be applied/tested</MudText>
                                </MudPaper>
                            </MudItem>
                        </MudGrid>

                        <MudGrid Spacing="3" Class="mb-4">
                            <MudItem xs="12" md="4">
                                <MudCard Elevation="3" Class="rounded-lg" Style="height:100%">
                                    <MudCardHeader>
                                        <CardHeaderContent>
                                            <MudText Typo="Typo.h6">Hypothesis outcomes</MudText>
                                        </CardHeaderContent>
                                    </MudCardHeader>
                                    <MudCardContent Class="d-flex justify-center">
                                        <MudChart T="double" ChartType="ChartType.Donut"
                                                  InputData="@_outcomeChartData" InputLabels="@_outcomeChartLabels"
                                                  ChartOptions="@_outcomeChartOptions"
                                                  Width="260px" Height="260px" />
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>
                            <MudItem xs="12" md="8">
                                <MudCard Elevation="3" Class="rounded-lg" Style="height:100%">
                                    <MudCardHeader>
                                        <CardHeaderContent>
                                            <MudText Typo="Typo.h6">Improvement per hypothesis (%)</MudText>
                                            <MudText Typo="Typo.caption">Positive = faster than baseline, negative = regression. Failed hypotheses are omitted.</MudText>
                                        </CardHeaderContent>
                                    </MudCardHeader>
                                    <MudCardContent>
                                        @if (_improvementSeries.Count > 0)
                                        {
                                            <MudChart T="double" ChartType="ChartType.Line"
                                                      ChartSeries="@_improvementSeries" XAxisLabels="@_improvementLabels"
                                                      ChartOptions="@_improvementChartOptions"
                                                      Width="100%" Height="260px" />
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.body2">No tested hypotheses yet.</MudText>
                                        }
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>
                        </MudGrid>
                    }

                    @if (_iterationOverviewSeries.Count > 0)
                    {
                        <MudCard Elevation="3" Class="rounded-lg mb-6">
                            <MudCardHeader>
                                <CardHeaderContent>
                                    <MudText Typo="Typo.h6">Research iterations &mdash; best server elapsed (after benchmark)</MudText>
                                    <MudText Typo="Typo.caption">Lower is faster. Baseline is shown next to the best &ldquo;after&rdquo; result of each iteration. A height of zero means no completed &ldquo;after&rdquo; benchmark yet.</MudText>
                                </CardHeaderContent>
                            </MudCardHeader>
                            <MudCardContent>
                                <MudChart T="double" ChartType="ChartType.Bar"
                                          ChartSeries="@_iterationOverviewSeries"
                                          XAxisLabels="@_iterationOverviewLabels"
                                          ChartOptions="@_elapsedChartOptions"
                                          Width="100%" Height="320px" />
                            </MudCardContent>
                        </MudCard>
                    }
                    else if (_orderedIterations.Count > 0)
                    {
                        <MudAlert Severity="Severity.Info" Class="mb-4" Dense="true">
                            Overview bars are zero until hypotheses finish with an &ldquo;after&rdquo; benchmark. Run research iterations to populate non-zero values.
                        </MudAlert>
                    }

                    @foreach (var block in _perIterationBlocks)
                    {
                        <MudCard Elevation="3" Class="rounded-lg mb-4">
                            <MudCardHeader>
                                <CardHeaderContent>
                                    <MudText Typo="Typo.h6">Iteration #@((int)(object)block.IterationId) &mdash; server elapsed per hypothesis</MudText>
                                    <MudText Typo="Typo.caption">Hypotheses in run order, baseline (before) vs optimized (after). Zero means no completed run for that hypothesis yet.</MudText>
                                </CardHeaderContent>
                            </MudCardHeader>
                            <MudCardContent>
                                <MudChart T="double" ChartType="ChartType.Bar"
                                          ChartSeries="@block.Series"
                                          XAxisLabels="@block.Labels"
                                          ChartOptions="@_elapsedChartOptions"
                                          Width="100%" Height="280px" />
                            </MudCardContent>
                        </MudCard>
                    }

                    @if (_orderedIterations.Count == 0)
                    {
                        <MudText Typo="Typo.body1">No research iterations yet.</MudText>
                    }
                </MudStack>
            </MudTabPanel>

            <MudTabPanel Text="SQL">
                <MudStack Spacing="0" Class="pt-4">
                    <SqlMonacoField EditorId="@($"experiment-view-e{Id}-benchmark")"
                                    Label="Benchmark SQL"
                                    HelperText="SQL used to measure performance."
                                    Value="@_experiment.BenchmarkSql"
                                    ReadOnly="true" />

                    <MudText Typo="Typo.subtitle2" Class="mb-2 mt-2">Hypothesis SQL</MudText>
                    <SqlMonacoField EditorId="@($"experiment-view-e{Id}-hypothesis-pre")"
                                    Label="Hypothesis Pre-Run SQL"
                                    HelperText="Executed before each hypothesis"
                                    Value="@_experiment.HypothesisPreRunSql"
                                    ReadOnly="true" />

                    <SqlMonacoField EditorId="@($"experiment-view-e{Id}-hypothesis-post")"
                                    Label="Hypothesis Post-Run SQL"
                                    HelperText="Executed after each hypothesis"
                                    Value="@_experiment.HypothesisPostRunSql"
                                    ReadOnly="true" />

                    <MudText Typo="Typo.subtitle2" Class="mb-2 mt-2">Experiment SQL</MudText>
                    <SqlMonacoField EditorId="@($"experiment-view-e{Id}-experiment-pre")"
                                    Label="Pre-Run SQL"
                                    HelperText="Executed before optimization starts"
                                    Value="@_experiment.ExperimentPreRunSql"
                                    ReadOnly="true" />

                    <SqlMonacoField EditorId="@($"experiment-view-e{Id}-experiment-post")"
                                    Label="Post-Run SQL"
                                    HelperText="Executed after each run"
                                    Value="@_experiment.ExperimentPostRunSql"
                                    ReadOnly="true" />
                </MudStack>
            </MudTabPanel>
        </MudTabs>
    }
</MudContainer>

@code {
    [Parameter] public int Id { get; set; }

    private readonly CancellationTokenSource _pageCts = new();

    private int _activeTabIndex;

    private Experiment? _experiment;
    private bool _loading = true;

    private List<ResearchIteration> _orderedIterations = new();

    private string[] _iterationOverviewLabels = Array.Empty<string>();
    private List<ChartSeries<double>> _iterationOverviewSeries = new();
    private List<IterationElapsedChartBlock> _perIterationBlocks = new();

    private int _totalHypotheses;
    private int _improvedCount;
    private int _regressedCount;
    private int _failedCount;
    private float _bestImprovement;
    private string? _bestHypothesisTitle;

    private double[] _outcomeChartData = Array.Empty<double>();
    private string[] _outcomeChartLabels = Array.Empty<string>();
    private ChartOptions _outcomeChartOptions = new();
    private List<ChartSeries<double>> _improvementSeries = new();
    private string[] _improvementLabels = Array.Empty<string>();
    private readonly ChartOptions _improvementChartOptions = new() { ChartPalette = new[] { "#43A047" } };
    private readonly ChartOptions _elapsedChartOptions = new() { ChartPalette = new[] { "#90A4AE", "#2196F3" } };

    public void Dispose()
    {
        _pageCts.Cancel();
        _pageCts.Dispose();
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var sec = Math.Max(1, UiPolling.Value.ResearchFlowRefreshSeconds);
            var experimentId = (ExperimentId)(object)Id;
            WatermarkBackgroundReload.Start(
                TimeSpan.FromSeconds(sec),
                _pageCts.Token,
                () => DataAccess.GetExperimentResultsWatermarkAsync(experimentId, _pageCts.Token),
                work => InvokeAsync(work),
                () => PageLoadCancellation.RunPageLoadAsync(LoadAsync, _pageCts.Token),
                () => InvokeAsync(StateHasChanged));
        }

        return Task.CompletedTask;
    }

    protected override Task OnInitializedAsync() =>
        PageLoadCancellation.RunPageLoadAsync(LoadAsync, _pageCts.Token);

    private async Task LoadAsync(CancellationToken ct)
    {
        await using var db = await DbContextFactory.CreateDbContextAsync(ct);
        var experimentId = (ExperimentId)(object)Id;
        _experiment = await db.Experiments.AsNoTracking()
            .Include(e => e.DatabaseConnection)
            .Include(e => e.AIConnection)
            .FirstOrDefaultAsync(e => e.Id == experimentId, ct);

        if (_experiment == null)
        {
            _loading = false;
            return;
        }

        _orderedIterations = await db.ResearchIterations.AsNoTracking()
            .Where(r => r.ExperimentId == experimentId)
            .OrderBy(r => r.CreatedAt)
            .ToListAsync(ct);

        if (_orderedIterations.Count == 0)
        {
            _loading = false;
            return;
        }

        var iterationIds = _orderedIterations.Select(r => r.Id).ToList();

        var hypotheses = await db.Hypotheses.AsNoTracking()
            .Where(h => iterationIds.Contains(h.ResearchIterationId))
            .Include(h => h.BenchmarkRunAfter)
            .Include(h => h.BenchmarkRunBefore)
            .OrderBy(h => h.CreatedAt)
            .ToListAsync(ct);

        var baselines = await db.BenchmarkRuns.AsNoTracking()
            .Where(b => _orderedIterations
                .Where(r => r.BaselineBenchmarkRunId != null)
                .Select(r => r.BaselineBenchmarkRunId!.Value)
                .Contains(b.Id))
            .ToDictionaryAsync(b => b.Id, ct);

        BuildKpis(hypotheses);
        BuildOverviewCharts(hypotheses, baselines);
        BuildPerIterationCharts(hypotheses, baselines);

        _loading = false;
    }

    private void BuildKpis(List<Hypothesis> hypotheses)
    {
        _totalHypotheses = hypotheses.Count;
        _failedCount = hypotheses.Count(h => h.Status == HypothesisState.Failed);

        var tested = hypotheses
            .Where(h => h.Status == HypothesisState.Completed && h.BenchmarkRunAfter != null)
            .ToList();

        _improvedCount = tested.Count(h => h.ImpovementPercentage > 5);
        _regressedCount = tested.Count(h => h.ImpovementPercentage < -5);
        var neutralCount = tested.Count - _improvedCount - _regressedCount;
        var untested = _totalHypotheses - tested.Count - _failedCount;

        var best = tested.OrderByDescending(h => h.ImpovementPercentage).FirstOrDefault();
        _bestImprovement = best?.ImpovementPercentage ?? 0;
        _bestHypothesisTitle = best is null || best.ImpovementPercentage <= 0
            ? null
            : $"Hypothesis #{(int)(object)best.Id}: {FirstLine(best.Description)}";

        var outcomes = new List<(string Label, int Count, string Hex)>
        {
            ("Improved", _improvedCount, "#43A047"),
            ("Regressed", _regressedCount, "#E53935"),
            ("No change", neutralCount, "#90A4AE"),
            ("Failed", _failedCount, "#6D4C41"),
            ("Untested", untested, "#BDBDBD"),
        };
        var present = outcomes.Where(o => o.Count > 0).ToList();
        _outcomeChartData = present.Select(o => (double)o.Count).ToArray();
        _outcomeChartLabels = present.Select(o => $"{o.Label} ({o.Count})").ToArray();
        _outcomeChartOptions = new ChartOptions { ChartPalette = present.Select(o => o.Hex).ToArray() };

        // Improvement line across all tested hypotheses in run order.
        _improvementLabels = tested.Select(h => $"#{(int)(object)h.Id}").ToArray();
        _improvementSeries = tested.Count == 0
            ? new List<ChartSeries<double>>()
            : new List<ChartSeries<double>>
            {
                new() { Name = "Improvement %", Data = tested.Select(h => (double)h.ImpovementPercentage).ToList() }
            };
    }

    private static string FirstLine(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return "(no description)";
        var line = text.AsSpan();
        var idx = line.IndexOfAny('\r', '\n');
        var first = idx >= 0 ? text[..idx] : text;
        return first.Length > 120 ? first[..120] + "…" : first;
    }

    private void BuildOverviewCharts(List<Hypothesis> hypotheses, Dictionary<BenchmarkRunId, BenchmarkRun> baselines)
    {
        var overviewLabels = new List<string>();
        var baselineData = new List<double>();
        var bestAfterData = new List<double>();

        foreach (var iteration in _orderedIterations)
        {
            overviewLabels.Add($"#{(int)(object)iteration.Id}");

            var baselineMs = iteration.BaselineBenchmarkRunId is { } baselineId &&
                             baselines.TryGetValue(baselineId, out var baseline)
                ? (double)baseline.TotalServerElapsedTimeMs
                : 0d;
            baselineData.Add(baselineMs);

            var msValues = hypotheses
                .Where(h => h.ResearchIterationId == iteration.Id && h.BenchmarkRunAfter != null)
                .Select(h => (double)h.BenchmarkRunAfter!.TotalServerElapsedTimeMs)
                .ToList();

            bestAfterData.Add(msValues.Count == 0 ? 0 : msValues.Min());
        }

        _iterationOverviewLabels = overviewLabels.ToArray();
        _iterationOverviewSeries = bestAfterData.Count == 0
            ? new List<ChartSeries<double>>()
            : new List<ChartSeries<double>>
            {
                new() { Name = "Baseline (ms)", Data = baselineData },
                new() { Name = "Best after (ms)", Data = bestAfterData },
            };
    }

    private void BuildPerIterationCharts(List<Hypothesis> hypotheses, Dictionary<BenchmarkRunId, BenchmarkRun> baselines)
    {
        var blocks = new List<IterationElapsedChartBlock>();

        foreach (var iteration in _orderedIterations)
        {
            var rows = hypotheses
                .Where(h => h.ResearchIterationId == iteration.Id)
                .OrderBy(h => h.CreatedAt)
                .ToList();

            if (rows.Count == 0)
                continue;

            var iterationBaselineMs = iteration.BaselineBenchmarkRunId is { } baselineId &&
                                      baselines.TryGetValue(baselineId, out var baseline)
                ? (double)baseline.TotalServerElapsedTimeMs
                : 0d;

            var labels = rows.Select(h => $"#{(int)(object)h.Id}").ToArray();
            var beforeData = rows
                .Select(h => h.BenchmarkRunBefore != null
                    ? (double)h.BenchmarkRunBefore.TotalServerElapsedTimeMs
                    : iterationBaselineMs)
                .ToList();
            var afterData = rows
                .Select(h => h.BenchmarkRunAfter != null ? (double)h.BenchmarkRunAfter.TotalServerElapsedTimeMs : 0d)
                .ToList();

            blocks.Add(new IterationElapsedChartBlock(
                iteration.Id,
                labels,
                new List<ChartSeries<double>>
                {
                    new() { Name = "Baseline / before (ms)", Data = beforeData },
                    new() { Name = "After optimization (ms)", Data = afterData },
                }));
        }

        _perIterationBlocks = blocks;
    }

    private sealed record IterationElapsedChartBlock(
        ResearchIterationId IterationId,
        string[] Labels,
        List<ChartSeries<double>> Series);
}
