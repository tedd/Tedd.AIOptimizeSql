@page "/db/{DbId:int}/analyses/new"
@implements IDisposable
@rendermode InteractiveServer
@inject IDbContextFactory<Tedd.AIOptimizeSql.Database.AIOptimizeDbContext> DbContextFactory
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@using Microsoft.EntityFrameworkCore
@using Tedd.AIOptimizeSql.Database
@using Tedd.AIOptimizeSql.Database.Models
@using Tedd.AIOptimizeSql.Database.Models.Enums

<PageTitle>New Database Analysis</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => Navigation.NavigateTo(DbRoutes.Analyses(DbId)))" />
        <MudText Typo="Typo.h4">New Database Analysis</MudText>
    </MudStack>

    <MudCard Elevation="3" Class="rounded-lg">
        <MudCardContent>
            <MudForm @ref="_form" @bind-IsValid="_formValid">
                <MudTextField @bind-Value="_name" Label="Name" Required="true"
                              RequiredError="Name is required" MaxLength="1024"
                              Variant="Variant.Outlined" Class="mb-4" />

                @* The database is not a choice here: it is the one you are already inside. *@
                <MudTextField Value="@(Db?.Name ?? $"#{DbId}")" Label="Database" ReadOnly="true"
                              Variant="Variant.Outlined" Class="mb-1" />
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
                    Analysis is always <strong>read-only</strong> against the target database, regardless of the
                    connection's analyze-only setting. The AI inspects metrics, runs SELECT/DMV queries and
                    estimated execution plans, but never changes anything — safe for production.
                </MudAlert>

                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-1">
                    <MudTextField Value="@AiDisplayName" Label="AI connection" ReadOnly="true"
                                  Variant="Variant.Outlined" Class="flex-grow-1" />
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.SmartToy"
                               OnClick="ChooseAiAsync">
                        @(_aiConnectionId is null ? "Choose AI" : "Change")
                    </MudButton>
                </MudStack>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-4 d-block">
                    Inherited from the database. Choosing one here binds it to the database, so later
                    analyses and experiments use it too.
                </MudText>

                <MudTextField @bind-Value="_instructions" Label="Instructions / focus areas (optional)"
                              HelperText="E.g. 'Focus on the Orders module' or 'We suspect nightly batch jobs are slow'"
                              Lines="3" Variant="Variant.Outlined" Class="mb-4" />

                <MudStack Row="true" Spacing="6" Wrap="Wrap.Wrap" Class="mb-2">
                    <MudSwitch @bind-Value="_enableWebSearch" Color="Color.Primary"
                               Label="Allow web search (requires configured API key)" />
                    <MudSwitch @bind-Value="_includeProcsAndViews" Color="Color.Primary"
                               Label="Review stored procedures and views" />
                </MudStack>

                <MudNumericField T="int" @bind-Value="_maxAiFindings" Label="Max AI findings" Min="1" Max="100"
                                 Variant="Variant.Outlined" Class="mb-4" Style="max-width: 220px;" />
            </MudForm>
        </MudCardContent>
        <MudCardActions Class="pa-4">
            <MudSpacer />
            <MudButton Variant="Variant.Text" OnClick="@(() => Navigation.NavigateTo(DbRoutes.Analyses(DbId)))" Class="mr-2">Cancel</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@(!_formValid || _saving)"
                       OnClick="@(() => Save(queue: false))" StartIcon="@Icons.Material.Filled.Save" Class="mr-2">
                Save as draft
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!_formValid || _saving)"
                       OnClick="@(() => Save(queue: true))" StartIcon="@Icons.Material.Filled.PlayArrow">
                Save &amp; Run
            </MudButton>
        </MudCardActions>
    </MudCard>
</MudContainer>

@code {
    [Parameter] public int DbId { get; set; }

    [CascadingParameter] private DatabaseScope? Db { get; set; }

    private readonly CancellationTokenSource _pageCts = new();

    private bool _formValid;
    private bool _saving;
    private MudForm? _form;

    private string _name = $"Analysis {DateTime.Now:yyyy-MM-dd HH:mm}";
    private AIConnectionId? _aiConnectionId;
    private string? _aiConnectionName;
    private string? _instructions;
    private bool _enableWebSearch = true;
    private bool _includeProcsAndViews = true;
    private int _maxAiFindings = 25;

    private string AiDisplayName => _aiConnectionName ?? "None — pick one before running";

    public void Dispose()
    {
        _pageCts.Cancel();
        _pageCts.Dispose();
    }

    protected override void OnParametersSet()
    {
        // The scope is cascaded by the route guard and can arrive after the first render.
        if (Db is not null && _aiConnectionId is null)
        {
            _aiConnectionId = Db.TypedAiConnectionId;
            _aiConnectionName = Db.AiConnectionName;
        }
    }

    /// <summary>
    /// Picking an AI binds it to the database, which is what turns "run an analysis with no AI"
    /// into a one-time question instead of a per-analysis one.
    /// </summary>
    private async Task ChooseAiAsync()
    {
        if (Db is null)
            return;

        // Force the prompt even when a binding exists, so this doubles as "change the AI".
        var unbound = Db with { AiConnectionId = null, AiConnectionName = null };
        var chosen = await AiBindingPrompt.EnsureAiConnectionAsync(
            unbound, DialogService, "An analysis needs an AI to run its deep dive.");

        if (chosen is null)
            return;

        _aiConnectionId = chosen;
        await using var db = await DbContextFactory.CreateDbContextAsync(_pageCts.Token);
        _aiConnectionName = await db.AIConnections.AsNoTracking()
            .Where(a => a.Id == chosen.Value)
            .Select(a => a.Name)
            .FirstOrDefaultAsync(_pageCts.Token);
    }

    private async Task Save(bool queue)
    {
        await _form!.ValidateAsync();
        if (!_formValid || _saving) return;

        if (_aiConnectionId is null)
        {
            await ChooseAiAsync();
            if (_aiConnectionId is null)
            {
                Snackbar.Add("An analysis needs an AI connection.", Severity.Warning);
                return;
            }
        }

        _saving = true;
        try
        {
            await using var db = await DbContextFactory.CreateDbContextAsync(_pageCts.Token);
            var now = DateTime.UtcNow;
            var analysis = new DatabaseAnalysis
            {
                Id = DatabaseAnalysisId.Transient,
                Name = _name,
                DatabaseConnectionId = (DatabaseConnectionId)DbId,
                AIConnectionId = _aiConnectionId,
                Instructions = string.IsNullOrWhiteSpace(_instructions) ? null : _instructions,
                EnableWebSearch = _enableWebSearch,
                IncludeStoredProceduresAndViews = _includeProcsAndViews,
                MaxAiFindings = _maxAiFindings,
                State = queue ? DatabaseAnalysisState.Queued : DatabaseAnalysisState.Draft,
                LastMessage = queue ? "Queued" : "Draft",
                CreatedAt = now,
                ModifiedAt = now,
            };
            db.DatabaseAnalyses.Add(analysis);
            await db.SaveChangesAsync(_pageCts.Token);

            Snackbar.Add(queue ? "Analysis queued — the worker will pick it up shortly." : "Analysis saved as draft.", Severity.Success);
            Navigation.NavigateTo(DbRoutes.Analysis(DbId, (int)(object)analysis.Id));
        }
        finally
        {
            _saving = false;
        }
    }
}
