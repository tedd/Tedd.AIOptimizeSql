@implements IDisposable
@inject IDbContextFactory<Tedd.AIOptimizeSql.Database.AIOptimizeDbContext> DbContextFactory
@inject IExperimentBlueprintService BlueprintService
@inject ISandboxScriptService SandboxScriptService
@inject IAIOptimizeDataAccess DataAccess
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@using Microsoft.EntityFrameworkCore
@using Tedd.AIOptimizeSql.Database
@using Tedd.AIOptimizeSql.OptimizeEngine.Models.SqlBrowser
@using Tedd.AIOptimizeSql.OptimizeEngine.Services.SqlBrowser
@using Tedd.AIOptimizeSql.WebUI.Components.Pages.SqlBrowser

<MudDialog>
    <DialogContent>
        <div class="wizard-content">
            @if (_loading)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else
            {
                @* ActionContent is deliberately empty: the stepper's own Previous/Next buttons would
                   sit inside the scrolling step surface, duplicating the dialog's Back/Next. *@
                <MudStepper ActiveIndex="_activeIndex" ActiveIndexChanged="OnActiveIndexChanged" NonLinear="true" ShowResetButton="false">
                    <ActionContent></ActionContent>
                    <ChildContent>
                    <MudStep Title="What are we making faster?">
                        <MudText Typo="Typo.body2" Class="mb-3">
                            We'll benchmark this query, let AI propose changes, apply/measure/revert each one automatically,
                            and keep only the changes that are <strong>both</strong> faster <strong>and</strong> return exactly the same rows.
                        </MudText>

                        @if (Finding is not null)
                        {
                            @* Started from a finding: the AI writes the query that would prove it,
                               because "we think this is slow" is not yet something you can measure. *@
                            <MudAlert Severity="Severity.Info" Class="mb-3">
                                <MudText Typo="Typo.subtitle2">From analysis finding: @Finding.Title</MudText>
                                @if (!string.IsNullOrWhiteSpace(Finding.Recommendation))
                                {
                                    <MudText Typo="Typo.body2" Class="mt-1">@Finding.Recommendation</MudText>
                                }
                            </MudAlert>

                            <MudStack Row="true" Spacing="2" Class="mb-3" AlignItems="AlignItems.Center">
                                <MudTooltip Text="This database has no AI bound to it." Disabled="@(_selectedAiConnectionId is not null)">
                                    <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                                               StartIcon="@Icons.Material.Filled.AutoAwesome"
                                               Disabled="@(_drafting || _selectedAiConnectionId is null)"
                                               OnClick="DraftFromFindingAsync">
                                        @(_drafting ? "Thinking…" : _draftDone ? "Re-draft with AI" : "Ask AI to draft the experiment")
                                    </MudButton>
                                </MudTooltip>
                                @if (_drafting)
                                {
                                    <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                                }
                            </MudStack>

                            @if (_draftError is not null)
                            {
                                <MudAlert Severity="Severity.Warning" Class="mb-3">@_draftError</MudAlert>
                            }
                        }

                        <SqlMonacoField EditorId="wizard-benchmark-sql" Label="Query being optimized"
                                        Value="@_blueprint.BenchmarkSql" ValueChanged="OnBenchmarkSqlChanged"
                                        HelperText="This is what every hypothesis is measured against — make it representative." />

                        <MudTextField T="string" Value="@_blueprint.Name" ValueChanged="OnNameChanged" Label="Experiment name" Variant="Variant.Outlined"
                                      Required="true" RequiredError="Give this experiment a name" Class="mb-4" />

                        <MudTextField @bind-Value="_goal" Label="What does &quot;faster&quot; mean here?" Variant="Variant.Outlined"
                                      Lines="2" Placeholder="e.g. fewer logical reads, sub-100ms under load, no table scans"
                                      HelperText="Optional, but it helps the AI focus on what actually matters to you." Class="mb-4" />

                        @if (_analyzeError is not null)
                        {
                            <MudAlert Severity="Severity.Error" Class="mb-3">@_analyzeError</MudAlert>
                        }

                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AnalyzeAsync"
                                   Disabled="@(_analyzing || string.IsNullOrWhiteSpace(_blueprint.Name) || string.IsNullOrWhiteSpace(_blueprint.BenchmarkSql))"
                                   StartIcon="@Icons.Material.Filled.TravelExplore">
                            @(_analyzing ? "Analyzing..." : _graph is null ? "Analyze" : "Re-analyze")
                        </MudButton>
                        @if (_analyzing)
                        {
                            <MudProgressLinear Indeterminate="true" Class="mt-2" />
                        }
                    </MudStep>

                    <MudStep Title="What it touches">
                        <MudText Typo="Typo.body2" Class="mb-3">
                            Ticked tables get integrity checksums before and after each hypothesis; in the sandbox modes
                            (next steps), they also get copied.
                        </MudText>

                        @if (_blueprint.Warnings.Count > 0)
                        {
                            <MudAlert Severity="Severity.Warning" Class="mb-3">
                                <ul class="wizard-list">
                                    @foreach (var w in _blueprint.Warnings)
                                    {
                                        <li>@w</li>
                                    }
                                </ul>
                            </MudAlert>
                        }

                        <DependencyGraphView Graph="_graph" Loading="_graphLoading"
                                             OnNodeSelected="OnNodeSelected" OnNodeScriptRequested="OnNodeScriptRequested" />

                        <MudTable Items="_blueprint.BaseTables" Dense="true" Hover="true" Class="mt-4">
                            <HeaderContent>
                                <MudTh>Include</MudTh>
                                <MudTh>Schema</MudTh>
                                <MudTh>Table</MudTh>
                                <MudTh>Rows</MudTh>
                                <MudTh>Reason</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Include"><MudCheckBox T="bool" @bind-Value="context.Include" /></MudTd>
                                <MudTd DataLabel="Schema">@context.Schema</MudTd>
                                <MudTd DataLabel="Table">@context.Table</MudTd>
                                <MudTd DataLabel="Rows">@(context.RowCount?.ToString("N0") ?? "—")</MudTd>
                                <MudTd DataLabel="Reason">@context.Reason</MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <MudText Typo="Typo.body2">No base tables discovered yet — run Analyze on step 1.</MudText>
                            </NoRecordsContent>
                        </MudTable>
                    </MudStep>

                    <MudStep Title="Proving the result is identical">
                        <MudText Typo="Typo.body2" Class="mb-3">
                            A "faster" query that returns different rows isn't an optimization — it's a bug. Pick how we prove
                            every hypothesis still returns exactly what the original query returned.
                        </MudText>

                        <MudRadioGroup T="OutputVerificationMode" Value="_blueprint.OutputVerificationMode" ValueChanged="OnVerificationModeChanged">
                            <MudPaper Class="pa-3 mb-2 wizard-option" Outlined="true">
                                <MudRadio T="OutputVerificationMode" Value="OutputVerificationMode.None">
                                    <strong>None</strong> — only speed is measured.
                                </MudRadio>
                                @if (_blueprint.OutputVerificationMode == OutputVerificationMode.None)
                                {
                                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                                        Not recommended — without an output check, a "faster" result could just be a wrong one.
                                    </MudAlert>
                                }
                            </MudPaper>
                            <MudPaper Class="pa-3 mb-2 wizard-option" Outlined="true">
                                <MudRadio T="OutputVerificationMode" Value="OutputVerificationMode.UnorderedHash">
                                    <strong>Unordered hash</strong> (default) — each row is hashed and the hashes are combined
                                    order-independently. Detects changed, added, removed, or duplicated rows, but tolerates a
                                    different row order. The right choice for a query without a meaningful ORDER BY.
                                </MudRadio>
                            </MudPaper>
                            <MudPaper Class="pa-3 mb-2 wizard-option" Outlined="true">
                                <MudRadio T="OutputVerificationMode" Value="OutputVerificationMode.OrderedHash">
                                    <strong>Ordered hash</strong> — pick this if your query has an ORDER BY that callers rely on;
                                    a different row order counts as a mismatch.
                                </MudRadio>
                            </MudPaper>
                        </MudRadioGroup>

                        @if (_blueprint.OutputVerificationMode != OutputVerificationMode.None)
                        {
                            @if (_confirmRegenerate)
                            {
                                <MudAlert Severity="Severity.Info" Class="my-2">
                                    Regenerating will discard your edits — regenerate anyway?
                                    <MudButton Size="Size.Small" Class="ml-2" OnClick="ConfirmRegenerate">Yes</MudButton>
                                    <MudButton Size="Size.Small" OnClick="@(() => _confirmRegenerate = false)">No</MudButton>
                                </MudAlert>
                            }
                            <SqlMonacoField EditorId="wizard-output-verification-sql" Label="Output verification SQL"
                                            Value="@_blueprint.OutputVerificationSql" ValueChanged="OnVerificationSqlChanged"
                                            HelperText="Returns one scalar fingerprint of the query's output." />
                            <MudStack Row="true" Spacing="2" Class="mb-3">
                                <MudButton Variant="Variant.Outlined" OnClick="RequestRegenerate">Regenerate from template</MudButton>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="TestVerificationAsync"
                                           Disabled="@(_verificationTesting || string.IsNullOrWhiteSpace(_blueprint.OutputVerificationSql))">
                                    @(_verificationTesting ? "Testing..." : "Test this check")
                                </MudButton>
                            </MudStack>

                            @if (_verificationTested)
                            {
                                <MudAlert Severity="@(_verificationDeterministic ? Severity.Success : Severity.Error)" Class="mt-2">
                                    @if (_verificationDeterministic)
                                    {
                                        <span>Deterministic — ran twice, same fingerprint both times: <code>@_verificationFirstHash</code></span>
                                    }
                                    else if (_verificationError is not null)
                                    {
                                        <span>Could not run the check: @_verificationError</span>
                                    }
                                    else
                                    {
                                        <span>
                                            Not deterministic — first run: <code>@_verificationFirstHash</code>, second run:
                                            <code>@_verificationSecondHash</code>. A check that disagrees with itself can never
                                            prove an optimization safe.
                                        </span>
                                    }
                                </MudAlert>
                            }
                        }
                    </MudStep>

                    <MudStep Title="Where it runs">
                        @if (_dbConnection?.AnalyzeOnly == true)
                        {
                            <MudAlert Severity="Severity.Warning" Class="mb-3">
                                This connection is analyze-only: nothing can apply, benchmark, or revert here. You can still
                                prepare this experiment, but it cannot actually run until it's attached to a non-analyze-only
                                connection.
                            </MudAlert>
                        }

                        <MudRadioGroup T="ExperimentIsolationMode" Value="_blueprint.IsolationMode" ValueChanged="OnIsolationModeChanged">
                            <MudPaper Class="pa-3 mb-2 wizard-option" Outlined="true">
                                <MudRadio T="ExperimentIsolationMode" Value="ExperimentIsolationMode.None">
                                    <strong>None</strong> — hypotheses are applied to, benchmarked against, and reverted from the
                                    target database as-is. Nothing is provisioned or torn down.
                                </MudRadio>
                            </MudPaper>
                            <MudPaper Class="pa-3 mb-2 wizard-option" Outlined="true">
                                <MudTooltip Text="Not available on an analyze-only connection." Disabled="@(_dbConnection?.AnalyzeOnly != true)">
                                    <MudRadio T="ExperimentIsolationMode" Value="ExperimentIsolationMode.SandboxSchema"
                                              Disabled="@(_dbConnection?.AnalyzeOnly == true)">
                                        <strong>Sandbox schema</strong> — copy the objects the benchmark touches into a dedicated
                                        schema in the same database (tables with indexes/constraints and data, views/procedures
                                        rewritten to point at the copies), run there, then drop the schema.
                                    </MudRadio>
                                </MudTooltip>
                            </MudPaper>
                            <MudPaper Class="pa-3 mb-2 wizard-option" Outlined="true">
                                <MudTooltip Text="Not available on an analyze-only connection." Disabled="@(_dbConnection?.AnalyzeOnly != true)">
                                    <MudRadio T="ExperimentIsolationMode" Value="ExperimentIsolationMode.CloneDatabase"
                                              Disabled="@(_dbConnection?.AnalyzeOnly == true)">
                                        <strong>Clone database</strong> — provision a separate database on the same server,
                                        populate it from the source database, run the whole experiment there, then drop it.
                                    </MudRadio>
                                </MudTooltip>
                            </MudPaper>
                        </MudRadioGroup>

                        @if (_blueprint.IsolationMode != ExperimentIsolationMode.None)
                        {
                            <MudAlert Severity="Severity.Info" Class="my-2">
                                The scripts below are written for you from the live catalog: every ticked table is recreated with
                                its real keys, indexes, computed columns and defaults, filled from the source, and its statistics
                                rebuilt — because a copy that is thinner than the original makes every measurement taken in it
                                meaningless. Regenerate after changing which tables are ticked.
                            </MudAlert>

                            @if (_blueprint.IsolationMode == ExperimentIsolationMode.SandboxSchema)
                            {
                                <MudTextField T="string" Value="@_blueprint.SandboxSchemaName" ValueChanged="OnSandboxSchemaNameChanged"
                                              Label="Sandbox schema name" Variant="Variant.Outlined" Class="mb-3" />
                            }
                            else
                            {
                                <MudTextField T="string" Value="@_blueprint.SandboxDatabaseName" ValueChanged="OnSandboxDatabaseNameChanged"
                                              Label="Sandbox database name" Variant="Variant.Outlined" Class="mb-3" />
                            }

                            <MudSelect T="AIConnectionId?" @bind-Value="_selectedAiConnectionId" Label="AI connection"
                                       Variant="Variant.Outlined" Dense="true" Class="mb-3" Clearable="true"
                                       HelperText="Used by &quot;Complete with AI&quot; here, and by the AI step later.">
                                @foreach (var conn in _aiConnections)
                                {
                                    <MudSelectItem Value="@((AIConnectionId?)conn.Id)">@conn.Name (@conn.Provider / @conn.Model)</MudSelectItem>
                                }
                            </MudSelect>

                            <MudStack Row="true" Spacing="2" Class="mb-3 flex-wrap">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GenerateSandboxAsync"
                                           Disabled="@SandboxBusy" StartIcon="@Icons.Material.Filled.AutoFixHigh">
                                    @(_sandboxGenerating ? "Generating..." : "Generate scripts")
                                </MudButton>
                                <MudTooltip Text="Pick an AI connection above to enable this."
                                            Disabled="@(_selectedAiConnectionId is not null)">
                                    <MudButton Variant="Variant.Outlined" OnClick="CompleteSandboxWithAiAsync"
                                               Disabled="@(SandboxBusy || _selectedAiConnectionId is null)"
                                               StartIcon="@Icons.Material.Filled.AutoAwesome">
                                        @(_sandboxAiRunning ? "Working..." : "Complete with AI")
                                    </MudButton>
                                </MudTooltip>
                                <MudButton Variant="Variant.Outlined" OnClick="ValidateSandboxAsync"
                                           Disabled="@(SandboxBusy || _dbConnection?.AnalyzeOnly == true)">
                                    @(_validatingSandbox ? "Validating..." : "Validate")
                                </MudButton>
                            </MudStack>

                            @if (_sandboxGenerating || _sandboxAiRunning)
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                                    <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                                    <MudText Typo="Typo.body2">@_sandboxProgress</MudText>
                                </MudStack>
                            }

                            @if (!string.IsNullOrWhiteSpace(_sandboxSummary))
                            {
                                <MudAlert Severity="Severity.Success" Dense="true" Class="mb-2">@_sandboxSummary</MudAlert>
                            }
                            @if (_sandboxWarnings.Count > 0)
                            {
                                <MudAlert Severity="Severity.Warning" Class="mb-2">
                                    <MudText Typo="Typo.subtitle2">The generator could not do everything:</MudText>
                                    <ul class="wizard-list">
                                        @foreach (var w in _sandboxWarnings)
                                        {
                                            <li>@w</li>
                                        }
                                    </ul>
                                </MudAlert>
                            }

                            <SqlMonacoField EditorId="wizard-sandbox-setup-sql" Label="Sandbox setup SQL"
                                            Value="@_blueprint.SandboxSetupSql" ValueChanged="OnSandboxSetupSqlChanged" />
                            <SqlMonacoField EditorId="wizard-sandbox-teardown-sql" Label="Sandbox teardown SQL"
                                            Value="@_blueprint.SandboxTeardownSql" ValueChanged="OnSandboxTeardownSqlChanged" />

                            @if (_sandboxValidateLog is not null)
                            {
                                <MudAlert Severity="@(_sandboxValidateOk == true ? Severity.Success : Severity.Error)" Class="mt-3">
                                    <pre class="wizard-log">@_sandboxValidateLog</pre>
                                    @if (_sandboxValidateError is not null)
                                    {
                                        <div>@_sandboxValidateError</div>
                                    }
                                </MudAlert>
                            }
                        }
                    </MudStep>

                    <MudStep Title="Let the AI finish the setup">
                        <MudText Typo="Typo.body2" Class="mb-3">
                            The AI fills in naming, description, instructions, the measurement plan, and — if you picked a
                            sandbox mode — the setup/teardown scripts. You can skip this and use the deterministic defaults
                            instead.
                        </MudText>

                        <MudSelect T="AIConnectionId?" @bind-Value="_selectedAiConnectionId" Label="AI connection"
                                   Variant="Variant.Outlined" Class="mb-4" Clearable="true">
                            @foreach (var conn in _aiConnections)
                            {
                                <MudSelectItem Value="@((AIConnectionId?)conn.Id)">@conn.Name (@conn.Provider / @conn.Model)</MudSelectItem>
                            }
                        </MudSelect>

                        <MudStack Row="true" Spacing="2" Class="mb-3">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RunAiAsync"
                                       Disabled="@(_aiRunning || _selectedAiConnectionId is null)">
                                @(_aiRunning ? "Working..." : "Ask AI to complete this experiment")
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" OnClick="SkipAiAsync" Disabled="_aiRunning">
                                Skip AI, use the deterministic setup
                            </MudButton>
                        </MudStack>

                        @if (_aiRunning)
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                                <MudText Typo="Typo.body2">@_aiProgress</MudText>
                            </MudStack>
                        }
                        @if (_aiCompleted)
                        {
                            <MudAlert Severity="Severity.Success" Class="mt-3">
                                AI finished. Revisit earlier steps to see the updated values — everything is still editable.
                            </MudAlert>
                        }
                    </MudStep>

                    <MudStep Title="Review and create">
                        @{
                            var blocking = BlockingWarnings();
                        }
                        @if (blocking.Count > 0)
                        {
                            <MudAlert Severity="Severity.Warning" Class="mb-3">
                                <MudText Typo="Typo.subtitle2">Before you create this experiment:</MudText>
                                <ul class="wizard-list">
                                    @foreach (var w in blocking)
                                    {
                                        <li>@w</li>
                                    }
                                </ul>
                            </MudAlert>
                        }
                        @if (_blueprint.Warnings.Count > 0)
                        {
                            <MudAlert Severity="Severity.Info" Class="mb-3">
                                <ul class="wizard-list">
                                    @foreach (var w in _blueprint.Warnings)
                                    {
                                        <li>@w</li>
                                    }
                                </ul>
                            </MudAlert>
                        }

                        <MudText Typo="Typo.subtitle1" Class="mb-2">Overview</MudText>
                        <MudSimpleTable Dense="true" Class="mb-4">
                            <tbody>
                                <tr><td>Name</td><td>@_blueprint.Name</td></tr>
                                <tr><td>Description</td><td>@(_blueprint.Description ?? "—")</td></tr>
                                <tr><td>Instructions</td><td>@(_blueprint.Instructions ?? "—")</td></tr>
                                <tr><td>Measurement plan</td><td>@(_blueprint.MeasurementPlan ?? "—")</td></tr>
                                <tr><td>Isolation mode</td><td>@_blueprint.IsolationMode</td></tr>
                                <tr><td>Sandbox schema</td><td>@(_blueprint.SandboxSchemaName ?? "—")</td></tr>
                                <tr><td>Sandbox database</td><td>@(_blueprint.SandboxDatabaseName ?? "—")</td></tr>
                                <tr><td>Output verification</td><td>@_blueprint.OutputVerificationMode</td></tr>
                                <tr>
                                    <td>Base tables</td>
                                    <td>@string.Join(", ", _blueprint.BaseTables.Where(t => t.Include).Select(t => $"{t.Schema}.{t.Table}"))</td>
                                </tr>
                                <tr><td>AI connection</td><td>@(_aiConnections.FirstOrDefault(c => c.Id == _selectedAiConnectionId)?.Name ?? "None")</td></tr>
                            </tbody>
                        </MudSimpleTable>

                        <MudText Typo="Typo.subtitle1">Benchmark SQL</MudText>
                        <SqlMonacoField EditorId="wizard-review-benchmark-sql" Value="@_blueprint.BenchmarkSql" ReadOnly="true" />

                        @if (!string.IsNullOrWhiteSpace(_blueprint.ExperimentPreRunSql))
                        {
                            <MudText Typo="Typo.subtitle2" Class="mt-2">Experiment pre-run SQL</MudText>
                            <SqlMonacoField EditorId="wizard-review-exp-pre" Value="@_blueprint.ExperimentPreRunSql" ReadOnly="true" />
                        }
                        @if (!string.IsNullOrWhiteSpace(_blueprint.ExperimentPostRunSql))
                        {
                            <MudText Typo="Typo.subtitle2" Class="mt-2">Experiment post-run SQL</MudText>
                            <SqlMonacoField EditorId="wizard-review-exp-post" Value="@_blueprint.ExperimentPostRunSql" ReadOnly="true" />
                        }
                        @if (!string.IsNullOrWhiteSpace(_blueprint.HypothesisPreRunSql))
                        {
                            <MudText Typo="Typo.subtitle2" Class="mt-2">Hypothesis pre-run SQL</MudText>
                            <SqlMonacoField EditorId="wizard-review-hyp-pre" Value="@_blueprint.HypothesisPreRunSql" ReadOnly="true" />
                        }
                        @if (!string.IsNullOrWhiteSpace(_blueprint.HypothesisPostRunSql))
                        {
                            <MudText Typo="Typo.subtitle2" Class="mt-2">Hypothesis post-run SQL</MudText>
                            <SqlMonacoField EditorId="wizard-review-hyp-post" Value="@_blueprint.HypothesisPostRunSql" ReadOnly="true" />
                        }
                        @if (_blueprint.IsolationMode != ExperimentIsolationMode.None)
                        {
                            <MudText Typo="Typo.subtitle2" Class="mt-2">Sandbox setup SQL</MudText>
                            <SqlMonacoField EditorId="wizard-review-sandbox-setup" Value="@_blueprint.SandboxSetupSql" ReadOnly="true" />
                            <MudText Typo="Typo.subtitle2" Class="mt-2">Sandbox teardown SQL</MudText>
                            <SqlMonacoField EditorId="wizard-review-sandbox-teardown" Value="@_blueprint.SandboxTeardownSql" ReadOnly="true" />
                        }
                        @if (_blueprint.OutputVerificationMode != OutputVerificationMode.None)
                        {
                            <MudText Typo="Typo.subtitle2" Class="mt-2">Output verification SQL</MudText>
                            <SqlMonacoField EditorId="wizard-review-output-verification" Value="@_blueprint.OutputVerificationSql" ReadOnly="true" />
                        }

                        <MudCheckBox T="bool" @bind-Value="_queueFirstIteration" Label="Queue a first research iteration now"
                                     Disabled="@(_dbConnection?.AnalyzeOnly == true)" Class="mt-3" />
                        @if (_dbConnection?.AnalyzeOnly == true)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Warning" Class="d-block">
                                This connection is analyze-only, so no iteration can run yet.
                            </MudText>
                        }
                    </MudStep>
                    </ChildContent>
                </MudStepper>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.NavigateBefore"
                   Disabled="@(_activeIndex == 0)" OnClick="GoBack">
            Back
        </MudButton>
        <MudSpacer />
        <MudButton Variant="Variant.Text" OnClick="CancelAsync">Cancel</MudButton>
        @if (_activeIndex < 5)
        {
            <MudTooltip Text="@BlockReason(_activeIndex)" Disabled="@string.IsNullOrEmpty(BlockReason(_activeIndex))">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Filled.NavigateNext"
                           Disabled="@(!CanAdvanceFromStep(_activeIndex))" OnClick="GoNext">
                    Next
                </MudButton>
            </MudTooltip>
        }
        else
        {
            <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Check"
                       Disabled="@_creating" OnClick="CreateExperimentAsync">
                @(_creating ? "Creating..." : "Create experiment")
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public DatabaseConnectionId ConnectionId { get; set; }

    /// <summary>Seed query, e.g. whatever was in the browser's editor. May be empty.</summary>
    [Parameter] public string Sql { get; set; } = "";

    /// <summary>Set when the wizard was opened from an analysis finding rather than from a query.</summary>
    [Parameter] public FindingExperimentContext? Finding { get; set; }

    /// <summary>The finding to link the created experiment back to, so it stops offering to re-create it.</summary>
    [Parameter] public AnalysisFindingId? FindingId { get; set; }

    /// <summary>The AI bound to the database, pre-selected so the AI steps work without a detour.</summary>
    [Parameter] public AIConnectionId? DefaultAiConnectionId { get; set; }

    private readonly CancellationTokenSource _cts = new();
    private AIOptimizeDbContext? _db;
    private bool _loading = true;
    private bool _hasProgress;
    private int _activeIndex;

    private ExperimentBlueprint _blueprint = new();
    private string _goal = "";

    /// <summary>
    /// Tables ticked in step 2, fed to <c>BuildOutputVerificationSql</c> so a benchmark with no
    /// result set of its own (a stored procedure with side effects) still gets a working
    /// fingerprint -- one over the tables it touches, instead of a placeholder telling the user
    /// to write it by hand.
    /// </summary>
    private static IReadOnlyList<(string Schema, string Table)> AffectedTables(ExperimentBlueprint blueprint) =>
        blueprint.BaseTables.Where(t => t.Include).Select(t => (t.Schema, t.Table)).ToList();
    private DatabaseConnection? _dbConnection;
    private List<AIConnection> _aiConnections = new();
    private AIConnectionId? _selectedAiConnectionId;

    private ObjectDependencyGraph? _graph;
    private bool _graphLoading;
    private string _schemaContextMarkdown = "";
    private bool _analyzing;
    private string? _analyzeError;

    private bool _drafting;
    private bool _draftDone;
    private string? _draftError;

    private bool _outputSqlManuallyEdited;
    private bool _nameManuallyEdited;
    private bool _confirmRegenerate;
    private bool _verificationTesting;
    private bool _verificationTested;
    private bool _verificationDeterministic;
    private string? _verificationFirstHash;
    private string? _verificationSecondHash;
    private string? _verificationError;

    private bool _validatingSandbox;
    private bool? _sandboxValidateOk;
    private string? _sandboxValidateLog;
    private string? _sandboxValidateError;

    private bool _sandboxGenerating;
    private bool _sandboxAiRunning;
    private string _sandboxProgress = "";
    private string? _sandboxSummary;
    private List<string> _sandboxWarnings = [];

    private bool SandboxBusy => _sandboxGenerating || _sandboxAiRunning || _validatingSandbox;

    private bool _aiRunning;
    private bool _aiCompleted;
    private string _aiProgress = "";

    private bool _queueFirstIteration = true;
    private bool _creating;

    protected override async Task OnInitializedAsync()
    {
        _db = await DbContextFactory.CreateDbContextAsync(_cts.Token);
        _dbConnection = await _db.DatabaseConnections.AsNoTracking()
            .FirstOrDefaultAsync(c => c.Id == ConnectionId, _cts.Token);
        _aiConnections = await _db.AIConnections.AsNoTracking().OrderBy(c => c.Name).ToListAsync(_cts.Token);

        _blueprint = new ExperimentBlueprint
        {
            Name = Finding is null
                ? $"Optimize query - {DateTime.Now:MMM d, HH:mm}"
                : $"Investigate: {Finding.Title}",
            BenchmarkSql = Sql,
        };

        // A finding often already carries the fix; the goal is stated in the finding's own words.
        if (Finding is not null && !string.IsNullOrWhiteSpace(Finding.Recommendation))
            _goal = Finding.Recommendation;

        _selectedAiConnectionId = DefaultAiConnectionId is { } defaultAi && _aiConnections.Any(c => c.Id == defaultAi)
            ? defaultAi
            : _aiConnections.Count == 1 ? _aiConnections[0].Id : null;

        if (_dbConnection?.AnalyzeOnly == true)
            _queueFirstIteration = false;

        _loading = false;
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
        _db?.Dispose();
        _db = null;
    }

    // ----- navigation -----

    private void OnActiveIndexChanged(int idx) => _activeIndex = idx;

    private void GoBack()
    {
        if (_activeIndex > 0) _activeIndex--;
    }

    private void GoNext()
    {
        if (_activeIndex < 5 && CanAdvanceFromStep(_activeIndex)) _activeIndex++;
    }

    private string BlockReason(int step) => step switch
    {
        0 => _graph is null ? "Run Analyze first so we know what this query touches." : "",
        2 => (_blueprint.OutputVerificationMode != OutputVerificationMode.None && !(_verificationTested && _verificationDeterministic))
            ? "Test the output-verification check first — it must return the same fingerprint twice before we can trust it."
            : "",
        _ => ""
    };

    private bool CanAdvanceFromStep(int step) => string.IsNullOrEmpty(BlockReason(step));

    private async Task CancelAsync()
    {
        if (!_hasProgress)
        {
            MudDialog.Cancel();
            return;
        }

        var confirm = await DialogService.ShowMessageBoxAsync(
            "Discard experiment setup?",
            "You've made progress in this wizard. Cancel and discard it?",
            yesText: "Discard", cancelText: "Keep editing");

        if (confirm == true)
            MudDialog.Cancel();
    }

    // ----- step 1: analyze -----

    private void OnNameChanged(string? value)
    {
        _blueprint.Name = value ?? "";
        _nameManuallyEdited = true;
        _hasProgress = true;
    }

    /// <summary>
    /// Editing the query invalidates the analysis: what it touches, the fingerprint script and
    /// the sandbox were all derived from the previous text.
    /// </summary>
    private void OnBenchmarkSqlChanged(string? value)
    {
        _blueprint.BenchmarkSql = value ?? "";
        _graph = null;
        _verificationTested = false;
        _hasProgress = true;
    }

    private async Task DraftFromFindingAsync()
    {
        if (Finding is null || _dbConnection is null)
            return;

        var aiConn = _aiConnections.FirstOrDefault(c => c.Id == _selectedAiConnectionId);
        if (aiConn is null)
            return;

        _drafting = true;
        _draftError = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            var draft = await BlueprintService.DraftFromFindingAsync(
                aiConn,
                Finding with
                {
                    DatabaseConnectionId = ConnectionId,
                    DatabaseName = _dbConnection.Name,
                },
                _cts.Token);

            _draftError = draft.Error;

            if (!string.IsNullOrWhiteSpace(draft.BenchmarkSql))
            {
                _blueprint.BenchmarkSql = draft.BenchmarkSql!;
                _graph = null;
                _verificationTested = false;
                _draftDone = true;
                _hasProgress = true;
            }

            if (!_nameManuallyEdited && !string.IsNullOrWhiteSpace(draft.Name))
                _blueprint.Name = draft.Name!;
            if (!string.IsNullOrWhiteSpace(draft.Goal))
                _goal = draft.Goal!;
            if (!string.IsNullOrWhiteSpace(draft.Instructions))
                _blueprint.Instructions = draft.Instructions;
        }
        catch (OperationCanceledException)
        {
            // The dialog is closing.
        }
        catch (Exception ex)
        {
            _draftError = $"Could not draft the experiment: {ex.Message}";
        }
        finally
        {
            _drafting = false;
        }
    }

    private async Task AnalyzeAsync()
    {
        if (_dbConnection is null)
        {
            _analyzeError = "Database connection not found.";
            return;
        }

        _analyzing = true;
        _graphLoading = true;
        _analyzeError = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var benchmarkSql = _blueprint.BenchmarkSql;
            var (blueprint, schemaMarkdown, graph) =
                await BlueprintService.AnalyzeQueryAsync(_dbConnection.ConnectionString, benchmarkSql, _cts.Token);

            // Preserve anything the user already decided in other steps (Analyze/Re-analyze is
            // reachable from any step thanks to non-linear navigation). Name is the exception:
            // until the user actually types one, keep adopting the freshly analyzed default --
            // otherwise the very first Analyze would "preserve" the generic placeholder set in
            // OnInitializedAsync instead of the real name computed from the query.
            if (_nameManuallyEdited)
                blueprint.Name = _blueprint.Name;
            blueprint.Description = _blueprint.Description;
            blueprint.Instructions = _blueprint.Instructions;
            blueprint.IsolationMode = _blueprint.IsolationMode;
            blueprint.SandboxSchemaName = _blueprint.SandboxSchemaName;
            blueprint.SandboxDatabaseName = _blueprint.SandboxDatabaseName;
            blueprint.SandboxSetupSql = _blueprint.SandboxSetupSql;
            blueprint.SandboxTeardownSql = _blueprint.SandboxTeardownSql;
            blueprint.OutputVerificationMode = _blueprint.OutputVerificationMode;
            blueprint.MeasurementPlan = _blueprint.MeasurementPlan;
            if (_outputSqlManuallyEdited)
                blueprint.OutputVerificationSql = _blueprint.OutputVerificationSql;
            else if (blueprint.OutputVerificationMode != OutputVerificationMode.None)
                blueprint.OutputVerificationSql = BlueprintService.BuildOutputVerificationSql(
                    blueprint.BenchmarkSql, blueprint.OutputVerificationMode, AffectedTables(blueprint));

            _blueprint = blueprint;
            _schemaContextMarkdown = schemaMarkdown;
            _graph = graph;
            _hasProgress = true;
            _verificationTested = false;
        }
        catch (Exception ex)
        {
            _analyzeError = $"Analyze failed: {ex.Message}";
        }
        finally
        {
            _analyzing = false;
            _graphLoading = false;
        }
    }

    private Task OnNodeSelected(DependencyNode node)
    {
        Snackbar.Add($"{node.Schema}.{node.Name}" + (node.Note is null ? "" : $" — {node.Note}"), Severity.Info);
        return Task.CompletedTask;
    }

    private Task OnNodeScriptRequested(DependencyNode node)
    {
        Snackbar.Add($"Scripting {node.Schema}.{node.Name} isn't available from the wizard yet.", Severity.Info);
        return Task.CompletedTask;
    }

    // ----- step 3: output verification -----

    private void OnVerificationModeChanged(OutputVerificationMode mode)
    {
        _blueprint.OutputVerificationMode = mode;
        _verificationTested = false;
        _verificationDeterministic = false;
        _hasProgress = true;

        if (mode == OutputVerificationMode.None)
        {
            _blueprint.OutputVerificationSql = null;
            _confirmRegenerate = false;
            return;
        }

        if (_outputSqlManuallyEdited)
        {
            _confirmRegenerate = true;
        }
        else
        {
            _blueprint.OutputVerificationSql = BlueprintService.BuildOutputVerificationSql(
                _blueprint.BenchmarkSql, mode, AffectedTables(_blueprint));
        }
    }

    private void RequestRegenerate()
    {
        if (_outputSqlManuallyEdited)
        {
            _confirmRegenerate = true;
        }
        else
        {
            _blueprint.OutputVerificationSql = BlueprintService.BuildOutputVerificationSql(
                _blueprint.BenchmarkSql, _blueprint.OutputVerificationMode, AffectedTables(_blueprint));
            _verificationTested = false;
        }
    }

    private void ConfirmRegenerate()
    {
        _blueprint.OutputVerificationSql = BlueprintService.BuildOutputVerificationSql(
            _blueprint.BenchmarkSql, _blueprint.OutputVerificationMode, AffectedTables(_blueprint));
        _outputSqlManuallyEdited = false;
        _confirmRegenerate = false;
        _verificationTested = false;
    }

    private void OnVerificationSqlChanged(string? value)
    {
        _blueprint.OutputVerificationSql = value;
        _outputSqlManuallyEdited = true;
        _verificationTested = false;
        _hasProgress = true;
    }

    private async Task TestVerificationAsync()
    {
        if (_dbConnection is null || string.IsNullOrWhiteSpace(_blueprint.OutputVerificationSql))
            return;

        _verificationTesting = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var result = await BlueprintService.TestOutputVerificationAsync(
                _dbConnection.ConnectionString, _blueprint.OutputVerificationSql!, _cts.Token);

            _verificationTested = true;
            _verificationDeterministic = result.Deterministic;
            _verificationFirstHash = result.FirstHash;
            _verificationSecondHash = result.SecondHash;
            _verificationError = result.Error;
            _hasProgress = true;
        }
        finally
        {
            _verificationTesting = false;
        }
    }

    // ----- step 4: isolation -----

    private async Task OnIsolationModeChanged(ExperimentIsolationMode mode)
    {
        _blueprint.IsolationMode = mode;
        _hasProgress = true;
        ResetSandboxFeedback();

        if (mode == ExperimentIsolationMode.SandboxSchema && string.IsNullOrWhiteSpace(_blueprint.SandboxSchemaName))
            _blueprint.SandboxSchemaName = $"aiopt_sandbox_{Guid.NewGuid().ToString("N")[..8]}";
        else if (mode == ExperimentIsolationMode.CloneDatabase && string.IsNullOrWhiteSpace(_blueprint.SandboxDatabaseName))
            _blueprint.SandboxDatabaseName = $"{_dbConnection?.Name ?? "db"}_Sandbox_{Guid.NewGuid().ToString("N")[..8]}";

        // Picking a sandbox mode is the point at which the scripts become relevant, so write them
        // straight away rather than leaving two empty editors and a button to find. Anything the
        // user has already typed is left alone.
        if (mode != ExperimentIsolationMode.None && string.IsNullOrWhiteSpace(_blueprint.SandboxSetupSql))
            await GenerateSandboxAsync();
    }

    private void OnSandboxSchemaNameChanged(string? value)
    {
        _blueprint.SandboxSchemaName = value;
        _hasProgress = true;
    }

    private void OnSandboxDatabaseNameChanged(string? value)
    {
        _blueprint.SandboxDatabaseName = value;
        _hasProgress = true;
    }

    private void OnSandboxSetupSqlChanged(string? value)
    {
        _blueprint.SandboxSetupSql = value;
        _hasProgress = true;
    }

    private void OnSandboxTeardownSqlChanged(string? value)
    {
        _blueprint.SandboxTeardownSql = value;
        _hasProgress = true;
    }

    private void ResetSandboxFeedback()
    {
        _sandboxValidateLog = null;
        _sandboxValidateError = null;
        _sandboxValidateOk = null;
        _sandboxSummary = null;
        _sandboxWarnings = [];
    }

    private SandboxScriptRequest BuildSandboxRequest() => new()
    {
        IsolationMode = _blueprint.IsolationMode,
        DatabaseConnectionId = ConnectionId,
        SandboxSchemaName = _blueprint.SandboxSchemaName,
        SandboxDatabaseName = _blueprint.SandboxDatabaseName,
        BenchmarkSql = _blueprint.BenchmarkSql,
        Tables = _blueprint.BaseTables
    };

    /// <summary>
    /// Takes generated scripts only when there are any: a refusal (a sandbox name that collides
    /// with something real) reports itself through the warnings and leaves the editors as they were.
    /// </summary>
    private void ApplySandboxScripts(SandboxScripts scripts)
    {
        _sandboxWarnings = scripts.Warnings.ToList();
        _sandboxSummary = scripts.Summary;
        _sandboxValidateLog = null;
        _sandboxValidateError = null;
        _sandboxValidateOk = null;

        if (string.IsNullOrWhiteSpace(scripts.Setup))
            return;

        _blueprint.SandboxSetupSql = scripts.Setup;
        _blueprint.SandboxTeardownSql = scripts.Teardown;
        _hasProgress = true;
    }

    private async Task GenerateSandboxAsync()
    {
        if (_dbConnection is null || _blueprint.IsolationMode == ExperimentIsolationMode.None)
            return;

        _sandboxGenerating = true;
        _sandboxProgress = "Reading the catalog...";
        await InvokeAsync(StateHasChanged);
        try
        {
            ApplySandboxScripts(await SandboxScriptService.GenerateAsync(
                _dbConnection.ConnectionString, BuildSandboxRequest(), _cts.Token));
        }
        catch (OperationCanceledException)
        {
            // The dialog is closing.
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not generate the sandbox scripts: {ex.Message}", Severity.Error);
        }
        finally
        {
            _sandboxGenerating = false;
        }
    }

    private async Task CompleteSandboxWithAiAsync()
    {
        if (_dbConnection is null || _blueprint.IsolationMode == ExperimentIsolationMode.None)
            return;

        var aiConn = _aiConnections.FirstOrDefault(c => c.Id == _selectedAiConnectionId);
        if (aiConn is null)
            return;

        _sandboxAiRunning = true;
        _sandboxProgress = "Starting...";
        await InvokeAsync(StateHasChanged);

        var progress = new Progress<string>(msg =>
        {
            _sandboxProgress = msg;
            _ = InvokeAsync(StateHasChanged);
        });

        try
        {
            ApplySandboxScripts(await SandboxScriptService.GenerateWithAiAsync(
                aiConn, _dbConnection.ConnectionString, BuildSandboxRequest(), progress, _cts.Token));
        }
        catch (OperationCanceledException)
        {
            // The dialog is closing.
        }
        catch (Exception ex)
        {
            Snackbar.Add($"The AI could not complete the sandbox scripts: {ex.Message}", Severity.Error);
        }
        finally
        {
            _sandboxAiRunning = false;
        }
    }

    private async Task ValidateSandboxAsync()
    {
        if (_dbConnection is null)
            return;

        _validatingSandbox = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var result = await BlueprintService.ValidateSandboxAsync(
                _dbConnection.ConnectionString, _blueprint.IsolationMode,
                _blueprint.SandboxSetupSql, _blueprint.SandboxTeardownSql, _blueprint.SandboxDatabaseName, _cts.Token);

            _sandboxValidateOk = result.Ok;
            _sandboxValidateLog = result.Log;
            _sandboxValidateError = result.Error;
            _hasProgress = true;
        }
        finally
        {
            _validatingSandbox = false;
        }
    }

    // ----- step 5: AI -----

    private async Task RunAiAsync()
    {
        if (_dbConnection is null || _selectedAiConnectionId is null)
            return;

        var aiConn = _aiConnections.FirstOrDefault(c => c.Id == _selectedAiConnectionId);
        if (aiConn is null)
            return;

        _aiRunning = true;
        _aiCompleted = false;
        _aiProgress = "Starting...";
        await InvokeAsync(StateHasChanged);

        var progress = new Progress<string>(msg =>
        {
            _aiProgress = msg;
            _ = InvokeAsync(StateHasChanged);
        });

        try
        {
            var request = new ExperimentBlueprintRequest
            {
                BenchmarkSql = _blueprint.BenchmarkSql,
                SchemaContextMarkdown = _schemaContextMarkdown,
                Goal = _goal,
                IsolationMode = _blueprint.IsolationMode,
                OutputVerificationMode = _blueprint.OutputVerificationMode,
                BaseTables = _blueprint.BaseTables.Where(t => t.Include).ToList(),
                DatabaseName = _dbConnection.Name,
                DatabaseConnectionId = ConnectionId,
            };

            _blueprint = await BlueprintService.CompleteWithAiAsync(
                aiConn, _dbConnection.ConnectionString, request, _blueprint, progress, _cts.Token);
            _aiCompleted = true;
            _hasProgress = true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"AI completion failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _aiRunning = false;
        }
    }

    private void SkipAiAsync() => _activeIndex = 5;

    // ----- step 6: review and create -----

    private List<string> BlockingWarnings()
    {
        var list = new List<string>();

        if (string.IsNullOrWhiteSpace(_blueprint.BenchmarkSql))
            list.Add("There is no benchmark query, so there is nothing to measure.");

        if (_blueprint.OutputVerificationMode != OutputVerificationMode.None && !(_verificationTested && _verificationDeterministic))
            list.Add("Output verification has not been proven deterministic — go back and test it.");

        if (_blueprint.IsolationMode != ExperimentIsolationMode.None)
        {
            if (string.IsNullOrWhiteSpace(_blueprint.SandboxSetupSql))
                list.Add("Isolation mode is set but there is no sandbox setup script — go back and generate one.");
            else if (_blueprint.SandboxSetupSql.Contains("TODO", StringComparison.OrdinalIgnoreCase))
                list.Add("The sandbox setup script still contains TODO markers, so it won't work as-is — regenerate it, or let the AI finish it.");

            if (string.IsNullOrWhiteSpace(_blueprint.SandboxTeardownSql))
                list.Add("There is no sandbox teardown script, so every iteration would leave its sandbox behind on the server.");
        }

        return list;
    }

    private async Task CreateExperimentAsync()
    {
        if (_db is null)
            return;

        _creating = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var experiment = new Experiment
            {
                Name = _blueprint.Name,
                Description = _blueprint.Description,
                Instructions = _blueprint.Instructions,
                BenchmarkSql = _blueprint.BenchmarkSql,
                ExperimentPreRunSql = _blueprint.ExperimentPreRunSql,
                ExperimentPostRunSql = _blueprint.ExperimentPostRunSql,
                HypothesisPreRunSql = _blueprint.HypothesisPreRunSql,
                HypothesisPostRunSql = _blueprint.HypothesisPostRunSql,
                IsolationMode = _blueprint.IsolationMode,
                SandboxSchemaName = _blueprint.SandboxSchemaName,
                SandboxDatabaseName = _blueprint.SandboxDatabaseName,
                SandboxSetupSql = _blueprint.SandboxSetupSql,
                SandboxTeardownSql = _blueprint.SandboxTeardownSql,
                OutputVerificationMode = _blueprint.OutputVerificationMode,
                OutputVerificationSql = _blueprint.OutputVerificationSql,
                DatabaseConnectionId = ConnectionId,
                AIConnectionId = _selectedAiConnectionId,
                CreatedAt = DateTime.UtcNow,
                ModifiedAt = DateTime.UtcNow,
            };

            _db.Experiments.Add(experiment);
            await _db.SaveChangesAsync(_cts.Token);

            // Close the loop back to the finding, so the analysis shows "open experiment"
            // instead of offering to create a second one for the same problem.
            if (FindingId is { } findingId)
            {
                var now = DateTime.UtcNow;
                await _db.AnalysisFindings
                    .Where(f => f.Id == findingId)
                    .ExecuteUpdateAsync(s => s
                        .SetProperty(f => f.ProposedExperimentId, (ExperimentId?)experiment.Id)
                        .SetProperty(f => f.ModifiedAt, now), _cts.Token);
            }

            if (_queueFirstIteration && _dbConnection?.AnalyzeOnly != true)
            {
                var iterationId = await DataAccess.CreateResearchIterationAsync(experiment.Id, hints: null, maxNumberOfHypotheses: 10, _cts.Token);
                await DataAccess.SetResearchIterationStateAsync(iterationId, ResearchIterationState.Queued, _cts.Token);
            }

            Snackbar.Add($"Experiment \"{experiment.Name}\" created.", Severity.Success);
            MudDialog.Close(DialogResult.Ok((int)(object)experiment.Id));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not create experiment: {ex.Message}", Severity.Error);
        }
        finally
        {
            _creating = false;
        }
    }
}
