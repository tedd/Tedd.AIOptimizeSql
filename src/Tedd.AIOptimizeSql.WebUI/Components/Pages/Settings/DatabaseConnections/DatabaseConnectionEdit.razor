@page "/settings/databases/new"
@page "/settings/databases/{Id:int}"
@implements IDisposable
@rendermode InteractiveServer
@inject IDbContextFactory<Tedd.AIOptimizeSql.Database.AIOptimizeDbContext> DbContextFactory
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject DatabaseScopeNotifier ScopeNotifier
@using Microsoft.EntityFrameworkCore
@using Tedd.AIOptimizeSql.Database
@using Tedd.AIOptimizeSql.Database.Models

<PageTitle>@(_isNew ? "New" : "Edit") Database Connection</PageTitle>

<EditNavigationGuard HasUnsavedChanges="@(() => IsModified)"
                     TrySaveAsync="TryPersistAsync"
                     DiscardAsync="DiscardChangesAsync" />

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="GoBack" />
        <MudText Typo="Typo.h4">@(_isNew ? "New" : "Edit") Database Connection</MudText>
    </MudStack>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_model == null)
    {
        <MudAlert Severity="Severity.Error">Connection not found.</MudAlert>
    }
    else if (_aiConnections.Count == 0)
    {
        @* A database carries the AI it works with, so there is nothing useful to save yet. *@
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            <MudText Typo="Typo.subtitle2">Add an AI connection first</MudText>
            <MudText Typo="Typo.body2" Class="mt-1">
                Every database is bound to the AI it works with — analyses and experiments started
                inside it inherit that AI — so there has to be one to bind to before a database can
                be created.
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" Class="mt-3"
                       StartIcon="@Icons.Material.Filled.SmartToy" Href="@DbRoutes.NewAiConnection">
                Add AI connection
            </MudButton>
        </MudAlert>
    }
    else
    {
        <MudCard Elevation="3" Class="rounded-lg">
            <MudCardContent>
                <MudForm @ref="_form" @bind-IsValid="_formValid">
                    <MudTextField @bind-Value="_model.Name" Label="Name" Required="true"
                                  RequiredError="Name is required" MaxLength="512"
                                  Variant="Variant.Outlined" Class="mb-4" />
                    <MudTextField @bind-Value="_model.ConnectionString" Label="Connection String" Required="true"
                                  RequiredError="Connection string is required" MaxLength="4000"
                                  Lines="3" Variant="Variant.Outlined" Class="mb-4" />

                    <MudSelect T="AIConnectionId?" @bind-Value="_model.AIConnectionId" Label="AI connection"
                               Required="true" RequiredError="Pick the AI this database works with"
                               Variant="Variant.Outlined" Class="mb-1">
                        @foreach (var ai in _aiConnections)
                        {
                            <MudSelectItem Value="@((AIConnectionId?)ai.Id)">@ai.Name (@ai.Provider / @ai.Model)</MudSelectItem>
                        }
                    </MudSelect>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-4 d-block">
                        Analyses, experiments and the Create Experiment wizard started inside this
                        database default to this AI. It cannot be deleted while this database still
                        points at it.
                    </MudText>

                    <MudSwitch @bind-Value="_model.AnalyzeOnly" Color="Color.Warning" Class="mb-1"
                               Label="Analyze only (production-safe)" />
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-4 d-block">
                        When enabled, nothing on this connection ever modifies the target database:
                        AI tools are restricted to read-only queries and estimated execution plans, benchmarks and
                        hypothesis apply/revert are skipped, and views, stored procedures, and data are never touched.
                    </MudText>

                    @if (!_isNew)
                    {
                        <MudStack Row="true" Spacing="4">
                            <MudText Typo="Typo.caption">Created: @_model.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudText>
                            <MudText Typo="Typo.caption">Modified: @_model.ModifiedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudText>
                        </MudStack>
                    }
                </MudForm>
            </MudCardContent>
            <MudCardActions Class="pa-4">
                <MudSpacer />
                <MudButton Variant="Variant.Text" OnClick="GoBack" Class="mr-2">Cancel</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!_formValid)"
                           OnClick="Save" StartIcon="@Icons.Material.Filled.Save">
                    Save
                </MudButton>
            </MudCardActions>
        </MudCard>
    }
</MudContainer>

@code {
    [Parameter] public int? Id { get; set; }

    private DatabaseConnection? _model;
    private bool _isNew;
    private bool _loading = true;
    private bool _formValid;
    private MudForm? _form;
    private readonly CancellationTokenSource _pageCts = new();
    private AIOptimizeDbContext? _db;
    private List<AIConnection> _aiConnections = new();
    private string _baselineName = "";
    private string _baselineConnectionString = "";
    private bool _baselineAnalyzeOnly;
    private AIConnectionId? _baselineAiConnectionId;

    private bool IsModified =>
        !_loading && _model != null &&
        (_model.Name != _baselineName || _model.ConnectionString != _baselineConnectionString
         || _model.AnalyzeOnly != _baselineAnalyzeOnly
         || _model.AIConnectionId != _baselineAiConnectionId);

    private void CaptureBaseline()
    {
        if (_model == null) return;
        _baselineName = _model.Name;
        _baselineConnectionString = _model.ConnectionString;
        _baselineAnalyzeOnly = _model.AnalyzeOnly;
        _baselineAiConnectionId = _model.AIConnectionId;
    }

    public void Dispose()
    {
        _pageCts.Cancel();
        _pageCts.Dispose();
        _db?.Dispose();
        _db = null;
    }

    protected override Task OnInitializedAsync() =>
        PageLoadCancellation.RunPageLoadAsync(async ct =>
        {
            _db = await DbContextFactory.CreateDbContextAsync(ct);
            _aiConnections = await _db.AIConnections.AsNoTracking().OrderBy(a => a.Name).ToListAsync(ct);

            if (Id.HasValue)
            {
                _isNew = false;
                var id = (DatabaseConnectionId)(object)Id.Value;
                _model = await _db.DatabaseConnections.AsNoTracking().FirstOrDefaultAsync(c => c.Id == id, ct);
            }
            else
            {
                _isNew = true;
                _model = new DatabaseConnection
                {
                    Name = "",
                    ConnectionString = "",
                    // One AI configured is not a choice; pre-select it so the common case is one field less.
                    AIConnectionId = _aiConnections.Count == 1 ? _aiConnections[0].Id : null,
                };
            }
            _loading = false;
            CaptureBaseline();
        }, _pageCts.Token);

    private async Task<bool> TryPersistAsync()
    {
        if (_db is null || _model == null) return false;
        await _form!.ValidateAsync();
        if (!_formValid) return false;

        if (_isNew)
        {
            _model.CreatedAt = DateTime.UtcNow;
            _model.ModifiedAt = DateTime.UtcNow;
            _db.DatabaseConnections.Add(_model);
            await _db.SaveChangesAsync();
            _db.ChangeTracker.Clear();
        }
        else
        {
            var id = (DatabaseConnectionId)(object)_model.Id;
            var now = DateTime.UtcNow;
            var n = await _db.DatabaseConnections.Where(c => c.Id == id).ExecuteUpdateAsync(s => s
                .SetProperty(c => c.Name, _model.Name)
                .SetProperty(c => c.ConnectionString, _model.ConnectionString)
                .SetProperty(c => c.AnalyzeOnly, _model.AnalyzeOnly)
                .SetProperty(c => c.AIConnectionId, _model.AIConnectionId)
                .SetProperty(c => c.ModifiedAt, now));
            if (n != 1)
            {
                Snackbar.Add("Connection not found or was deleted.", Severity.Error);
                return false;
            }

            _model.ModifiedAt = now;
        }
        Snackbar.Add(_isNew ? "Connection created" : "Connection saved", Severity.Success);
        CaptureBaseline();

        // The app bar and nav read the database from the cascaded scope; without this a rename
        // or an AI rebind would keep showing the values from when the database was opened.
        await ScopeNotifier.NotifyChangedAsync();
        return true;
    }

    private async Task Save()
    {
        if (!await TryPersistAsync()) return;
        Navigation.NavigateTo(DbRoutes.DatabaseConnections);
    }

    private async Task DiscardChangesAsync()
    {
        if (_db is null || _model == null) return;
        if (_isNew)
        {
            _model = new DatabaseConnection
            {
                Name = "",
                ConnectionString = "",
                AIConnectionId = _aiConnections.Count == 1 ? _aiConnections[0].Id : null,
            };
        }
        else
        {
            var id = (DatabaseConnectionId)(object)_model.Id;
            _model = await _db.DatabaseConnections.AsNoTracking().FirstOrDefaultAsync(c => c.Id == id, _pageCts.Token);
            if (_model == null)
            {
                Snackbar.Add("Connection not found.", Severity.Error);
                return;
            }
        }

        CaptureBaseline();
        await InvokeAsync(StateHasChanged);
    }

    private void GoBack() => Navigation.NavigateTo(DbRoutes.DatabaseConnections);
}
