@page "/settings/ai"
@implements IDisposable
@rendermode InteractiveServer
@inject IDbContextFactory<Tedd.AIOptimizeSql.Database.AIOptimizeDbContext> DbContextFactory
@inject IAIOptimizeDataAccess DataAccess
@inject IOptions<UiPollingOptions> UiPolling
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject DatabaseScopeNotifier ScopeNotifier
@using Microsoft.EntityFrameworkCore

<PageTitle>AI Connections</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
        <MudText Typo="Typo.h4">AI Connections</MudText>
        <MudSpacer />
        @if (_selectedItems.Count > 0)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                       OnClick="DeleteSelected" Class="mr-2">
                Delete Selected (@_selectedItems.Count)
            </MudButton>
        }
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                   Href="@DbRoutes.NewAiConnection">
            New AI Connection
        </MudButton>
    </MudStack>

    <MudTable @ref="_table" T="AIConnection" ServerData="LoadServerData" Hover="true" Elevation="3"
              Dense="true" FixedHeader="true" MultiSelection="true" @bind-SelectedItems="_selectedItems"
              OnRowClick="OnRowClick" RowClass="cursor-pointer" Class="rounded-lg">
        <HeaderContent>
            <MudTh><MudTableSortLabel SortLabel="Name" T="AIConnection">Name</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="Provider" T="AIConnection">Provider</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="Model" T="AIConnection">Model</MudTableSortLabel></MudTh>
            <MudTh>Used by</MudTh>
            <MudTh><MudTableSortLabel SortLabel="Endpoint" T="AIConnection">Endpoint</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="CreatedAt" T="AIConnection">Created</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="ModifiedAt" T="AIConnection">Modified</MudTableSortLabel></MudTh>
            <MudTh Style="width: 80px;">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Provider">
                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">@context.Provider.ToString()</MudChip>
            </MudTd>
            <MudTd DataLabel="Model">@context.Model</MudTd>
            <MudTd DataLabel="Used by">
                @if (_usedBy.TryGetValue(context.Id, out var dbNames) && dbNames.Count > 0)
                {
                    <MudText Typo="Typo.body2">@string.Join(", ", dbNames)</MudText>
                }
                else
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">—</MudText>
                }
            </MudTd>
            <MudTd DataLabel="Endpoint">
                <MudText Typo="Typo.body2" Style="max-width:250px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                    @context.Endpoint
                </MudText>
            </MudTd>
            <MudTd DataLabel="Created">@context.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</MudTd>
            <MudTd DataLabel="Modified">@context.ModifiedAt.ToLocalTime().ToString("yyyy-MM-dd")</MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                               OnClick="@(() => DeleteSingle(context))" aria-label="Delete" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body1" Class="pa-4">No AI connections found.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { 20, 50, 100 }" />
        </PagerContent>
    </MudTable>
</MudContainer>

@code {
    private readonly CancellationTokenSource _pageCts = new();
    private MudTable<AIConnection>? _table;
    private HashSet<AIConnection> _selectedItems = new();

    /// <summary>Databases bound to each AI, so "in use" is visible before you reach for Delete.</summary>
    private Dictionary<AIConnectionId, List<string>> _usedBy = new();

    public void Dispose()
    {
        _pageCts.Cancel();
        _pageCts.Dispose();
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var sec = Math.Max(1, UiPolling.Value.EntityListRefreshSeconds);
            WatermarkBackgroundReload.Start(
                TimeSpan.FromSeconds(sec),
                _pageCts.Token,
                () => DataAccess.GetMaxAiConnectionModifiedAtAsync(_pageCts.Token),
                work => InvokeAsync(work),
                async () =>
                {
                    if (_table is not null)
                        await _table.ReloadServerData();
                },
                () => InvokeAsync(StateHasChanged));
        }

        return Task.CompletedTask;
    }

    private Task<TableData<AIConnection>> LoadServerData(TableState state, CancellationToken ct) =>
        PageLoadCancellation.RunTableLoadAsync(t => LoadServerDataCore(state, t), _pageCts.Token, ct);

    private async Task<TableData<AIConnection>> LoadServerDataCore(TableState state, CancellationToken cancellationToken)
    {
        await using var db = await DbContextFactory.CreateDbContextAsync(cancellationToken);
        IQueryable<AIConnection> query = db.AIConnections;

        query = state.SortLabel switch
        {
            "Name" => state.SortDirection == SortDirection.Descending ? query.OrderByDescending(x => x.Name) : query.OrderBy(x => x.Name),
            "Provider" => state.SortDirection == SortDirection.Descending ? query.OrderByDescending(x => x.Provider) : query.OrderBy(x => x.Provider),
            "Model" => state.SortDirection == SortDirection.Descending ? query.OrderByDescending(x => x.Model) : query.OrderBy(x => x.Model),
            "Endpoint" => state.SortDirection == SortDirection.Descending ? query.OrderByDescending(x => x.Endpoint) : query.OrderBy(x => x.Endpoint),
            "CreatedAt" => state.SortDirection == SortDirection.Descending ? query.OrderByDescending(x => x.CreatedAt) : query.OrderBy(x => x.CreatedAt),
            "ModifiedAt" => state.SortDirection == SortDirection.Descending ? query.OrderByDescending(x => x.ModifiedAt) : query.OrderBy(x => x.ModifiedAt),
            _ => query.OrderByDescending(x => x.ModifiedAt)
        };

        var totalItems = await query.CountAsync(cancellationToken);
        var items = await query.Skip(state.Page * state.PageSize).Take(state.PageSize).ToListAsync(cancellationToken);

        var ids = items.Select(a => a.Id).ToList();
        _usedBy = (await db.DatabaseConnections.AsNoTracking()
                .Where(c => c.AIConnectionId != null && ids.Contains(c.AIConnectionId.Value))
                .OrderBy(c => c.Name)
                .Select(c => new { AiId = c.AIConnectionId!.Value, c.Name })
                .ToListAsync(cancellationToken))
            .GroupBy(x => x.AiId)
            .ToDictionary(g => g.Key, g => g.Select(x => x.Name).ToList());

        return new TableData<AIConnection> { TotalItems = totalItems, Items = items };
    }

    private void OnRowClick(TableRowClickEventArgs<AIConnection> args)
    {
        Navigation.NavigateTo(DbRoutes.AiConnection((int)(object)args.Item!.Id));
    }

    private async Task DeleteSingle(AIConnection item)
    {
        if (!await ConfirmDeleteAsync([item]))
            return;

        await DataAccess.ClearAiConnectionReferencesAsync(item.Id);
        await using var db = await DbContextFactory.CreateDbContextAsync();
        var deleted = await db.AIConnections.Where(a => a.Id == item.Id).ExecuteDeleteAsync();
        if (deleted == 0)
            return;
        Snackbar.Add($"Deleted \"{item.Name}\"", Severity.Success);
        await ScopeNotifier.NotifyChangedAsync();
        await _table!.ReloadServerData();
    }

    private async Task DeleteSelected()
    {
        var items = _selectedItems.ToList();
        if (items.Count == 0 || !await ConfirmDeleteAsync(items))
            return;

        var ids = items.Select(i => i.Id).ToList();
        foreach (var id in ids)
            await DataAccess.ClearAiConnectionReferencesAsync(id);
        await using var db = await DbContextFactory.CreateDbContextAsync();
        var deleted = await db.AIConnections.Where(a => ids.Contains(a.Id)).ExecuteDeleteAsync();
        Snackbar.Add(deleted == 0 ? "Nothing deleted" : $"Deleted {deleted} AI connection(s)", deleted == 0 ? Severity.Info : Severity.Success);
        _selectedItems.Clear();
        await ScopeNotifier.NotifyChangedAsync();
        await _table!.ReloadServerData();
    }

    /// <summary>
    /// An AI a database is still bound to is not deleted silently: the databases that would be
    /// left without one are named, and confirming unbinds them as part of the delete.
    /// </summary>
    private async Task<bool> ConfirmDeleteAsync(IReadOnlyList<AIConnection> items)
    {
        var boundDatabases = new List<string>();
        foreach (var item in items)
            boundDatabases.AddRange(await DataAccess.GetDatabaseNamesUsingAiConnectionAsync(item.Id));

        var what = items.Count == 1
            ? $"AI connection \"{items[0].Name}\""
            : $"{items.Count} AI connections";

        if (boundDatabases.Count == 0)
        {
            var plain = await DialogService.ShowMessageBoxAsync(
                "Confirm delete",
                $"Delete {what}? Experiments, analyses and research iteration snapshots using it will have their AI reference cleared.",
                yesText: "Delete", cancelText: "Cancel");
            return plain == true;
        }

        var names = string.Join(", ", boundDatabases.Distinct().OrderBy(n => n));
        var confirm = await DialogService.ShowMessageBoxAsync(
            "Still in use by a database",
            $"{what} is bound to: {names}. Deleting it leaves {(boundDatabases.Count == 1 ? "that database" : "those databases")} " +
            "without an AI, and anything started there will ask for a new one. Unbind and delete anyway?",
            yesText: "Unbind and delete", cancelText: "Keep it");
        return confirm == true;
    }
}
