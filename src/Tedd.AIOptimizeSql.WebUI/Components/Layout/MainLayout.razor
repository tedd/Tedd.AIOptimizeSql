@inherits LayoutComponentBase
@inject SecurityState Security

<MudThemeProvider @bind-IsDarkMode="_isDarkMode" Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="4" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="ml-2">AI SQL Optimizer</MudText>

        @* Which database everything on screen belongs to, always visible: every list, every
           experiment and every analysis below is filtered to it. *@
        @if (Db is not null)
        {
            <MudChip T="string" Class="ml-4" Size="Size.Small" Color="Color.Surface" Variant="Variant.Filled"
                     Icon="@Icons.Material.Filled.Storage" Href="@DbRoutes.SelectDatabase"
                     title="Switch database">
                @Db.Name
            </MudChip>
            @if (Db.AnalyzeOnly)
            {
                <MudTooltip Text="Analyze only: nothing on this connection ever modifies the target database.">
                    <MudChip T="string" Class="ml-1" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled"
                             Icon="@Icons.Material.Filled.Shield">analyze-only</MudChip>
                </MudTooltip>
            }
            @if (!Db.HasAi)
            {
                <MudTooltip Text="No AI is bound to this database — analyses and experiments will ask for one.">
                    <MudChip T="string" Class="ml-1" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled"
                             Icon="@Icons.Material.Filled.SmartToy" Href="@DbRoutes.DatabaseConnection(Db.Id)">
                        no AI
                    </MudChip>
                </MudTooltip>
            }
        }

        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.DarkMode" Color="Color.Inherit"
                       OnClick="@ToggleDarkMode" aria-label="Toggle dark mode" />
        @if (Security.AuthenticationEnabled)
        {
            @* Plain form post: signing out must clear the auth cookie, which interactive
               Blazor cannot do — the /auth/logout endpoint handles it. *@
            <form method="post" action="auth/logout" class="d-flex">
                <AntiforgeryToken />
                <MudIconButton ButtonType="ButtonType.Submit" Icon="@Icons.Material.Filled.Logout"
                               Color="Color.Inherit" aria-label="Sign out" title="Sign out" />
            </form>
        }
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2" Variant="DrawerVariant.Mini"
               OpenMiniOnHover="true">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <div class="pa-4">
            @Body
        </div>
    </MudMainContent>
</MudLayout>

@code {
    [CascadingParameter] private DatabaseScope? Db { get; set; }

    private bool _drawerOpen = true;
    private bool _isDarkMode = true;

    private MudTheme _theme = new MudTheme
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#1976D2",
            Secondary = "#7C4DFF",
            AppbarBackground = "#1565C0",
            Background = "#f5f5f5",
            Surface = "#ffffff",
            DrawerBackground = "#ffffff",
            DrawerText = "#424242",
            Success = "#2E7D32",
            Warning = "#F57C00",
            Error = "#D32F2F",
            Info = "#0288D1"
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#42A5F5",
            Secondary = "#B388FF",
            AppbarBackground = "#0D47A1",
            Background = "#121212",
            Surface = "#1E1E1E",
            DrawerBackground = "#1a1a2e",
            DrawerText = "#e0e0e0",
            Success = "#66BB6A",
            Warning = "#FFA726",
            Error = "#EF5350",
            Info = "#29B6F6"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = new[] { "Inter", "Helvetica", "Arial", "sans-serif" }
            }
        }
    };

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private void ToggleDarkMode() => _isDarkMode = !_isDarkMode;
}
